def _safe_int(val: Any, default: int = 0) -> int:
    if val is None:
        return default
    if isinstance(val, int):
        return val
    try:
        s = str(val).strip()
        if not s:
            return default
        return int(s)
    except Exception:
        return default

# Кэши результатов _is_user / _is_chat по имени класса.
# Chaquopy: hasattr() на Java-объекте — рефлексия JVM (~10-50µs каждый вызов).
# При прокрутке RecyclerView каждый getUser() проходит через хук → экономим ms/frame.
_USER_CLASS_CACHE: Dict[str, bool] = {}
_CHAT_CLASS_CACHE: Dict[str, bool] = {}
_FIND_CLASS_CACHE: Dict[str, Any] = {}
_AYU_VALID_ATTRS: Optional[List[str]] = None
_EXTERA_VALID_ATTRS: Optional[List[str]] = None
_KOTO_VALID_ATTRS: Optional[List[str]] = None
_SHARED_VALID_ATTRS: Optional[List[str]] = None

def _find_class_cached(class_name: str) -> Any:
    if class_name in _FIND_CLASS_CACHE:
        return _FIND_CLASS_CACHE[class_name]
    try:
        cls = find_class(class_name)
        if len(_FIND_CLASS_CACHE) < 200:
            _FIND_CLASS_CACHE[class_name] = cls
        return cls
    except Exception:
        if len(_FIND_CLASS_CACHE) < 200:
            _FIND_CLASS_CACHE[class_name] = None
        return None

def _is_user(obj: Any) -> bool:
    if obj is None:
        return False
    cls_key = type(obj).__name__
    cached = _USER_CLASS_CACHE.get(cls_key)
    if cached is not None:
        return cached
    lowered = cls_key.lower()
    if "user" in lowered:
        result = True
    else:
        result = bool(hasattr(obj, "first_name") or hasattr(obj, "phone") or hasattr(obj, "last_name"))
    if len(_USER_CLASS_CACHE) < 100:
        _USER_CLASS_CACHE[cls_key] = result
    return result

def _is_chat(obj: Any) -> bool:
    if obj is None:
        return False
    cls_key = type(obj).__name__
    cached = _CHAT_CLASS_CACHE.get(cls_key)
    if cached is not None:
        return cached
    lowered = cls_key.lower()
    if "chat" in lowered or "channel" in lowered:
        result = True
    else:
        result = bool(hasattr(obj, "title") or hasattr(obj, "broadcast") or hasattr(obj, "megagroup"))
    if len(_CHAT_CLASS_CACHE) < 100:
        _CHAT_CLASS_CACHE[cls_key] = result
    return result

def _normalize_chat_id(cid: Any) -> int:
    if isinstance(cid, int) and cid > 0:
        return cid
    raw = _safe_int(cid, 0)
    if raw == 0:
        return 0
    if raw > 0:
        return raw
    s = str(raw)
    if s.startswith("-100") and len(s) > 4:
        try:
            return int(s[4:])
        except Exception:
            return abs(raw)
    return abs(raw)

def _get_class_methods(cls_obj: Any) -> List[Any]:
    if cls_obj is None:
        return []
    target = cls_obj
    if not hasattr(target, "getDeclaredMethods") and hasattr(target, "getClass"):
        try:
            target = target.getClass()
        except Exception:
            pass
    methods = []
    seen = set()
    if hasattr(target, "getDeclaredMethods"):
        try:
            for m in target.getDeclaredMethods():
                p_types = getattr(m, "getParameterTypes", lambda: [])()
                m_key = (getattr(m, "getName", lambda: "")(), tuple(getattr(p, "getName", lambda: "")() for p in p_types))
                if m_key not in seen:
                    seen.add(m_key)
                    methods.append(m)
        except Exception:
            pass
    if hasattr(target, "getMethods"):
        try:
            for m in target.getMethods():
                p_types = getattr(m, "getParameterTypes", lambda: [])()
                m_key = (getattr(m, "getName", lambda: "")(), tuple(getattr(p, "getName", lambda: "")() for p in p_types))
                if m_key not in seen:
                    seen.add(m_key)
                    methods.append(m)
        except Exception:
            pass
    return methods

def _is_ayugram() -> bool:
    try:
        from com.radolyn.ayugram import AyuConfig
        return True
    except Exception:
        pass
    try:
        c = _find_class_cached("com.radolyn.ayugram.AyuConfig")
        return c is not None
    except Exception:
        return False

# Кэш TL_peerColor объектов: (color_id, bg_emoji_id) → TL_peerColor.
# Избегает создание новых Java-объектов на каждый getUser() вызов при прокрутке.
# TG читает значения int-полей и не модифицирует их — обмен безопасен.
_peer_color_cache: Dict[Any, Any] = {}
# Кэш TL_emojiStatus объектов: document_id → TL_emojiStatus.
_emoji_status_cache: Dict[int, Any] = {}
_STATIC_PEER_COLORS: Dict[int, Any] = {}

def _build_peer_color(color_id: Any, bg_emoji_id: Any):
    bg = _safe_int(bg_emoji_id, 0)
    c = _safe_int(color_id, -1) if color_id is not None else -1
    if c < 0 and bg == 0:
        return None
    if c < 0:
        c = 0
    if bg == 0 and c in _STATIC_PEER_COLORS:
        return _STATIC_PEER_COLORS[c]

    cache_key = (c, bg)
    if cache_key in _peer_color_cache:
        return _peer_color_cache[cache_key]

    try:
        global TLRPC
        if TLRPC is None:
            from org.telegram.tgnet import TLRPC as _TLRPC
            TLRPC = _TLRPC
        if TLRPC is not None:
            pc = TLRPC.TL_peerColor()
            pc.color = c
            if bg != 0:
                pc.background_emoji_id = bg
                pc.flags = 3
            else:
                pc.background_emoji_id = 0
                pc.flags = 1
            if len(_peer_color_cache) < 500:
                _peer_color_cache[cache_key] = pc
            return pc
    except Exception:
        pass
    return None

def _build_emoji_status(em_id: int):
    if not em_id:
        return None
    cached = _emoji_status_cache.get(em_id)
    if cached is not None:
        return cached
    try:
        global TLRPC
        if TLRPC is None:
            from org.telegram.tgnet import TLRPC as _TLRPC
            TLRPC = _TLRPC
        if TLRPC is not None:
            st = TLRPC.TL_emojiStatus()
            st.document_id = em_id
            if len(_emoji_status_cache) < 500:
                _emoji_status_cache[em_id] = st
            return st
    except Exception:
        pass
    return None

_EMOJI_DOC_ID_CACHE: Dict[str, Optional[int]] = {}
_PATCHED_MSGS: Set[Tuple[int, int]] = set()

def _extract_emoji_doc_id_from_url(url: str) -> Optional[int]:
    """Быстрое извлечение ID документа из ссылки без urllib.parse с O(1) in-memory кэшем."""
    if not url or ("emoji" not in url):
        return None
    cached = _EMOJI_DOC_ID_CACHE.get(url)
    if cached is not None:
        return cached if cached > 0 else None
    try:
        res = None
        if url.startswith("tg://emoji") or url.startswith("tg://custom-emoji"):
            idx = url.find("id=")
            if idx != -1:
                end_idx = url.find("&", idx)
                val = url[idx + 3 : end_idx] if end_idx != -1 else url[idx + 3 :]
                if val.isdigit():
                    res = int(val)
        elif "t.me/emoji/" in url:
            idx = url.find("t.me/emoji/") + 11
            end_idx = url.find("?", idx)
            slash_idx = url.find("/", idx)
            if end_idx != -1 and slash_idx != -1:
                end = min(end_idx, slash_idx)
            elif end_idx != -1:
                end = end_idx
            elif slash_idx != -1:
                end = slash_idx
            else:
                end = len(url)
            val = url[idx:end]
            if val.isdigit():
                res = int(val)
        elif "id=" in url:
            idx = url.find("id=")
            end_idx = url.find("&", idx)
            val = url[idx + 3 : end_idx] if end_idx != -1 else url[idx + 3 :]
            if val.isdigit():
                res = int(val)
        if len(_EMOJI_DOC_ID_CACHE) > 1000:
            _EMOJI_DOC_ID_CACHE.clear()
        _EMOJI_DOC_ID_CACHE[url] = res if res is not None else 0
        return res
    except Exception:
        pass
    return None

def _get_entity_doc_id(ent: Any) -> int:
    """Извлекает document_id из TL_messageEntityCustomEmoji или TL_inputMessageEntityCustomEmoji."""
    if ent is None:
        return 0
    # 1. Direct document_id attribute (TL_messageEntityCustomEmoji)
    doc_id = getattr(ent, "document_id", None)
    if doc_id is not None:
        try:
            val = int(doc_id)
            if val != 0:
                return val
        except Exception:
            pass

    # 2. Nested document.id attribute (TL_inputMessageEntityCustomEmoji)
    doc = getattr(ent, "document", None)
    if doc is not None:
        doc_id = getattr(doc, "id", None)
        if doc_id is not None:
            try:
                val = int(doc_id)
                if val != 0:
                    return val
            except Exception:
                pass

    # 3. Direct id if entity is Document
    if hasattr(ent, "id") and "Document" in type(ent).__name__:
        try:
            val = int(getattr(ent, "id", 0) or 0)
            if val != 0:
                return val
        except Exception:
            pass

    return 0

def _convert_custom_emojis_to_text_urls(entities: Any) -> Any:
    """Преобразует TL_messageEntityCustomEmoji / TL_inputMessageEntityCustomEmoji
    -> TL_messageEntityTextUrl (tg://emoji?id=...) при отправке сообщений без официального Premium."""
    if not entities:
        return entities

    try:
        is_py_list = isinstance(entities, list)
        is_java_list = (not is_py_list) and hasattr(entities, "size") and hasattr(entities, "get")
        count = len(entities) if is_py_list else (entities.size() if is_java_list else len(entities))
        if count == 0:
            return entities

        # ── Fast-path pre-check: есть ли кастомные эмодзи ──
        has_custom_emoji = False
        for i in range(count):
            ent = entities[i] if is_py_list else (entities.get(i) if is_java_list else entities[i])
            if ent is not None and _get_entity_doc_id(ent) != 0:
                has_custom_emoji = True
                break

        if not has_custom_emoji:
            return entities

        global TLRPC
        if TLRPC is None:
            try:
                from org.telegram.tgnet import TLRPC as _TLRPC
                TLRPC = _TLRPC
            except Exception:
                pass

        if TLRPC is None:
            return entities

        modified = False
        new_list = []
        for i in range(count):
            ent = entities[i] if is_py_list else (entities.get(i) if is_java_list else entities[i])
            if ent is not None:
                doc_id_val = _get_entity_doc_id(ent)
                if doc_id_val != 0:
                    tu = TLRPC.TL_messageEntityTextUrl()
                    tu.offset = int(getattr(ent, "offset", 0) or 0)
                    tu.length = int(getattr(ent, "length", 0) or 0)
                    tu.url = f"tg://emoji?id={doc_id_val}"
                    new_list.append(tu)
                    modified = True
                    continue
            new_list.append(ent)

        if not modified:
            return entities

        if is_py_list:
            return new_list

        try:
            from java.util import ArrayList
            java_arr = ArrayList()
            for item in new_list:
                java_arr.add(item)
            return java_arr
        except Exception:
            return new_list
    except Exception as e:
        log(f"SyncProfile: error converting custom emojis to text urls: {e}")
        return entities

def _convert_text_urls_to_custom_emojis(entities: Any) -> Any:
    """Преобразует TL_messageEntityTextUrl (tg://emoji?id=...) -> TL_messageEntityCustomEmoji
    для отображения кастомных эмодзи в интерфейсе клиента."""
    if not entities:
        return entities

    try:
        is_py_list = isinstance(entities, list)
        is_java_list = (not is_py_list) and hasattr(entities, "size") and hasattr(entities, "get")
        count = len(entities) if is_py_list else (entities.size() if is_java_list else len(entities))
        if count == 0:
            return entities

        # ── Fast-path: проверяем наличие URL ──
        has_emoji_url = False
        for i in range(count):
            ent = entities[i] if is_py_list else (entities.get(i) if is_java_list else entities[i])
            if ent is not None:
                url = getattr(ent, "url", None)
                if url and "emoji" in str(url):
                    has_emoji_url = True
                    break

        if not has_emoji_url:
            return entities

        global TLRPC
        if TLRPC is None:
            try:
                from org.telegram.tgnet import TLRPC as _TLRPC
                TLRPC = _TLRPC
            except Exception:
                pass

        if TLRPC is None:
            return entities

        modified = False
        new_list = []
        for i in range(count):
            ent = entities[i] if is_py_list else (entities.get(i) if is_java_list else entities[i])
            if ent is not None:
                url = getattr(ent, "url", None)
                if url:
                    doc_id = _extract_emoji_doc_id_from_url(str(url))
                    if doc_id and doc_id > 0:
                        ce = TLRPC.TL_messageEntityCustomEmoji()
                        ce.offset = int(getattr(ent, "offset", 0) or 0)
                        ce.length = int(getattr(ent, "length", 0) or 0)
                        ce.document_id = int(doc_id)
                        new_list.append(ce)
                        modified = True
                        continue
            new_list.append(ent)

        if not modified:
            return entities

        if is_py_list:
            return new_list

        try:
            from java.util import ArrayList
            arr = ArrayList()
            for item in new_list:
                arr.add(item)
            return arr
        except Exception:
            return new_list
    except Exception as e:
        logger.debug(f"_convert_text_urls_to_custom_emojis error: {e}")
        return entities

def _patch_message_entities(msg: Any):
    """Патчит сущности отдельного сообщения TLRPC.Message с O(1) in-memory защитой от повторной обработки."""
    if not msg:
        return
    try:
        if getattr(msg, "_sp_p", False):
            return
        msg_id = int(getattr(msg, "id", 0) or 0)
        dialog_id = int(getattr(msg, "dialog_id", 0) or 0)
        msg_key = (dialog_id, msg_id)
        if msg_id != 0 and msg_key in _PATCHED_MSGS:
            return
        try:
            msg._sp_p = True
        except Exception:
            pass
        ents = getattr(msg, "entities", None)
        if ents:
            new_ents = _convert_text_urls_to_custom_emojis(ents)
            if new_ents is not ents:
                msg.entities = new_ents
        if msg_id != 0:
            if len(_PATCHED_MSGS) > 5000:
                _PATCHED_MSGS.clear()
            _PATCHED_MSGS.add(msg_key)
    except Exception:
        pass

def _patch_messages_in_response(obj: Any):
    """Патчит все сообщения в ответе MTProto или контейнере Updates."""
    if not obj:
        return
    try:
        msgs = getattr(obj, "messages", None)
        if msgs:
            for m in msgs:
                if m:
                    _patch_message_entities(m)
        msg = getattr(obj, "message", None)
        if msg:
            _patch_message_entities(msg)
        upds = getattr(obj, "updates", None)
        if upds:
            for u in upds:
                if u:
                    u_msg = getattr(u, "message", None)
                    if u_msg:
                        _patch_message_entities(u_msg)
    except Exception:
        pass

class Plugin(BasePlugin):
    def _is_ayugram(self) -> bool:
        return _is_ayugram()

    def __init__(self):
        super().__init__()
        self._profiles_cache: Dict[int, Dict[str, Any]] = {}
        self._chats_cache: Dict[int, Dict[str, Any]] = {}
        self._sync_lock = threading.Lock()
        self._sync_op_lock = threading.Lock()
        # Lock-free snapshot for hot-path reads from UI/getter threads
        self._profiles_snapshot: Dict[int, Dict[str, Any]] = {}
        self._chats_snapshot: Dict[int, Dict[str, Any]] = {}
        self._cache_dirty = False
        self._is_running = True
        self._stop_event = threading.Event()
        self._xposed_unhooks: List[Any] = []
        self._json_cache_file = None
        self._last_selected_message: Optional[Any] = None

        self._video_avatar_uids: set = set()
        self._video_checked_uids: set = set()
        self._video_checked_chat_ids: set = set()
        self._handled_uids: set = set()
        self._handled_cids: set = set()
        self._cache_version: int = 1
        self._patch_cache: Dict[int, Any] = {}

        # ── Баг 3: кэш последнего применённого профиля собственных аккаунтов ──
        self._own_apply_cache: Dict[int, Any] = {}

        # ── Баг 4: счётчик ошибок для exponential backoff в keep-alive ──
        self._consecutive_errors: int = 0

        # ── Прем-эмодзи: кэш UID собственных аккаунтов для O(1) поиска в hasPremium/getCurrentUser хуках ──
        self._own_uids_cache: set = set()
        self._own_slots_cache: Dict[int, int] = {}
        self._show_badge_in_about: bool = True
        self._sync_in_progress: bool = False
        self._last_shown_bulletin: Tuple[int, float] = (0, 0.0)
        self._cached_active_accs: Optional[List[Dict[str, Any]]] = None
        self._cached_active_accs_time: float = 0.0

        if HAS_ZWYLIB:
            try:
                self._json_cache_file = JsonCacheFile("sync_profiles_cache.json", default={}, compress=True)
            except Exception as e:
                logger.error(f"Failed to init JsonCacheFile: {e}")

    def on_plugin_load(self):
        logger.info(f"SyncProfile v{__version__}: Загрузка (ZwyLib: {'Включен' if HAS_ZWYLIB else 'Не установлен'})...")
        self._is_running = True
        # Инициализируем TLRPC один раз при загрузке, чтобы не проверять
        # `if TLRPC is None` на каждый вызов getUser() в hot-path.
        global TLRPC
        if TLRPC is None:
            try:
                from org.telegram.tgnet import TLRPC as _TLRPC
                TLRPC = _TLRPC
            except Exception:
                pass
        if TLRPC is not None and not _STATIC_PEER_COLORS:
            for c in range(21):
                try:
                    pc = TLRPC.TL_peerColor()
                    pc.color = c
                    pc.background_emoji_id = 0
                    pc.flags = 1
                    _STATIC_PEER_COLORS[c] = pc
                except Exception:
                    pass
        self._load_local_profiles_cache()
        self._auto_import_from_official_tg_premium()
        self._ensure_local_premium()
        self._sync_local_ayuconfig()
        self._show_badge_in_about = self.get_setting("show_syncprofile_badge_in_about", True)

        # Заполняем кэш UID собственных аккаунтов (для исключения из перезаписи в AyuGram)
        active_accs = self._get_active_accounts_data()
        self._own_uids_cache = {acc["user_id"] for acc in active_accs if acc.get("user_id", 0) > 0}
        self._own_slots_cache = {acc["user_id"]: acc["acc_idx"] for acc in active_accs if acc.get("user_id", 0) > 0}
        self._update_snapshot()

        self._register_menu_items()
        self._register_xposed_hooks()
        # В AyuGram отправка кастомных эмодзи поддерживается нативно клиентом (AyuConfig / Local Premium).
        # Плагин НЕ перехватывает исходящие сообщения (sendMessage, sendMedia и т.д.),
        # чтобы не ломать посты в каналах и не конфликтовать с нативной отправкой AyuGram.

        # В AyuGram отправка и отображение кастомных эмодзи поддерживаются нативно клиентом (AyuConfig / Local Premium).
        # Плагин НЕ перехватывает сообщения и не модифицирует сущности сообщений,
        # полностью доверяя нативному движку AyuGram.

        if HAS_ZWYLIB:
            async_manager.run_task(self._async_initial_background_sync())
            async_manager.run_task(self._async_keep_alive_sync_loop())
        else:
            threading.Thread(target=self._initial_background_sync, daemon=True).start()
            threading.Thread(target=self._keep_alive_sync_loop, daemon=True).start()

        logger.info(f"SyncProfile v{__version__}: Успешно загружен!")

    def on_send_message_hook(self, account: int, params: Any) -> HookResult:
        """В AyuGram отправка сообщений обрабатывается нативно клиентом. Хук возвращает DEFAULT."""
        return HookResult(strategy=HookStrategy.DEFAULT)

    def pre_request_hook(self, request_name: str, account: int, request: Any) -> HookResult:
        """В AyuGram исходящие MTProto-запросы отправки сообщений не модифицируются."""
        return HookResult(strategy=HookStrategy.DEFAULT)

    def post_request_hook(self, request_name: str, account: int, response: Any, error: Any) -> HookResult:
        """Перехват входящих ответов MTProto с пользователями и чатами:
        проактивно патчит объекты пользователей и чатов из ответа сервера."""
        if error or not response or not request_name:
            return HookResult(strategy=HookStrategy.DEFAULT)
        if not (
            request_name.startswith("messages.")
            or request_name.startswith("channels.")
            or request_name.startswith("contacts.")
            or request_name.startswith("users.")
            or request_name.startswith("updates.")
            or request_name.startswith("photos.")
            or request_name.startswith("stories.")
        ):
            return HookResult(strategy=HookStrategy.DEFAULT)
        try:
            users = getattr(response, "users", None)
            if users:
                try:
                    for u in users:
                        if u is not None:
                            uid = getattr(u, "id", 0)
                            if uid and (uid in self._profiles_snapshot or uid in self._own_uids_cache):
                                self._patch_user_tl_object(u)
                except TypeError:
                    u_count = users.size() if hasattr(users, "size") else len(users)
                    for i in range(u_count):
                        u = users.get(i)
                        if u is not None:
                            uid = getattr(u, "id", 0)
                            if uid and (uid in self._profiles_snapshot or uid in self._own_uids_cache):
                                self._patch_user_tl_object(u)

            single_user = getattr(response, "user", None)
            if single_user is not None:
                uid = getattr(single_user, "id", 0)
                if uid and (uid in self._profiles_snapshot or uid in self._own_uids_cache):
                    self._patch_user_tl_object(single_user)

            chats = getattr(response, "chats", None)
            if chats:
                try:
                    for c in chats:
                        if c is not None:
                            cid = _normalize_chat_id(getattr(c, "id", 0))
                            if cid and cid in self._chats_snapshot:
                                self._patch_chat_tl_object(c)
                except TypeError:
                    c_count = chats.size() if hasattr(chats, "size") else len(chats)
                    for i in range(c_count):
                        c = chats.get(i)
                        if c is not None:
                            cid = _normalize_chat_id(getattr(c, "id", 0))
                            if cid and cid in self._chats_snapshot:
                                self._patch_chat_tl_object(c)

            single_chat = getattr(response, "chat", None)
            if single_chat is not None:
                cid = _normalize_chat_id(getattr(single_chat, "id", 0))
                if cid and cid in self._chats_snapshot:
                    self._patch_chat_tl_object(single_chat)
        except Exception:
            pass
        return HookResult(strategy=HookStrategy.DEFAULT)

    def on_updates_hook(self, container_name: str, account: int, updates: Any) -> HookResult:
        """Перехват контейнеров Updates (живые обновления чатов и пользователей)."""
        if not updates:
            return HookResult(strategy=HookStrategy.DEFAULT)
        try:
            users = getattr(updates, "users", None)
            if users:
                try:
                    for u in users:
                        if u is not None:
                            uid = getattr(u, "id", 0)
                            if uid and (uid in self._profiles_snapshot or uid in self._own_uids_cache):
                                self._patch_user_tl_object(u)
                except TypeError:
                    u_count = users.size() if hasattr(users, "size") else len(users)
                    for i in range(u_count):
                        u = users.get(i)
                        if u is not None:
                            uid = getattr(u, "id", 0)
                            if uid and (uid in self._profiles_snapshot or uid in self._own_uids_cache):
                                self._patch_user_tl_object(u)

            chats = getattr(updates, "chats", None)
            if chats:
                try:
                    for c in chats:
                        if c is not None:
                            cid = _normalize_chat_id(getattr(c, "id", 0))
                            if cid and cid in self._chats_snapshot:
                                self._patch_chat_tl_object(c)
                except TypeError:
                    c_count = chats.size() if hasattr(chats, "size") else len(chats)
                    for i in range(c_count):
                        c = chats.get(i)
                        if c is not None:
                            cid = _normalize_chat_id(getattr(c, "id", 0))
                            if cid and cid in self._chats_snapshot:
                                self._patch_chat_tl_object(c)
        except Exception:
            pass
        return HookResult(strategy=HookStrategy.DEFAULT)

    def on_update_hook(self, update_name: str, account: int, update: Any) -> HookResult:
        """Перехват одиночных Update."""
        return HookResult(strategy=HookStrategy.DEFAULT)

    def on_app_event(self, event_type: AppEvent):
        """Обработка событий жизненного цикла приложения (START, RESUME, PAUSE, STOP)."""
        if event_type in (AppEvent.START, AppEvent.RESUME):
            def _bg_resume_task():
                self._ensure_local_premium()
                self._sync_local_ayuconfig()
                run_on_ui_thread(self._apply_all_to_all_accounts)

            threading.Thread(target=_bg_resume_task, daemon=True).start()

            # Проверяем необходимость фонового обновления при возврате в приложение
            if self.get_setting("enable_sync", True):
                now = time.time()
                last_ts = _safe_int(self.get_setting("_last_sync_timestamp", 0))
                interval_secs = self._get_sync_interval_seconds()
                if last_ts == 0 or (now - last_ts) >= interval_secs:
                    if HAS_ZWYLIB:
                        async_manager.run_task(self._async_sync_delta_updates(show_bulletin=False))
                    else:
                        threading.Thread(
                            target=self.sync_delta_updates_from_server,
                            kwargs={"show_bulletin": False},
                            daemon=True,
                        ).start()

    def on_plugin_unload(self):
        self._is_running = False
        self._stop_event.set()
        if HAS_ZWYLIB:
            try:
                async_manager.cancel_all_for(__id__)
            except Exception:
                pass

        self._unregister_xposed_hooks()
        self._save_local_profiles_cache(force=True)
        logger.info(f"SyncProfile v{__version__}: Выгружен.")

    def _ensure_local_premium(self):
        """В AyuGram локальный премиум управляется нативно самим клиентом (AyuConfig).
        Плагин не вмешивается в AyuConfig, сохраняя пользовательские настройки клиента."""
        global _SHARED_VALID_ATTRS
        # Telegram SharedConfig (нативная поддержка анимации видеоаватаров при необходимости)
        try:
            from org.telegram.messenger import SharedConfig
            if _SHARED_VALID_ATTRS is None:
                candidate_attrs = ("animateAvatars", "autoplayVideo", "autoplayGifs", "loopStickers")
                _SHARED_VALID_ATTRS = [a for a in candidate_attrs if hasattr(SharedConfig, a)]

            changed_sc = False
            for attr in _SHARED_VALID_ATTRS:
                if not getattr(SharedConfig, attr):
                    setattr(SharedConfig, attr, True)
                    changed_sc = True
            if changed_sc and hasattr(SharedConfig, "saveConfig"):
                SharedConfig.saveConfig()
        except Exception:
            pass

    def _auto_import_from_official_tg_premium(self):
        imported_any = False
        try:
            from org.telegram.messenger import UserConfig
            max_accs = getattr(UserConfig, "MAX_ACCOUNT_COUNT", 4)
            for acc in range(max_accs):
                try:
                    u_cfg = UserConfig.getInstance(acc)
                    if not u_cfg or not u_cfg.isClientActivated():
                        continue

                    curr_user = u_cfg.getCurrentUser()
                    if not curr_user:
                        continue

                    is_real_premium = bool(
                        getattr(curr_user, "premium", False)
                        or ((getattr(curr_user, "flags", 0) or 0) & 0x10000000) != 0
                    )
                    has_official_color = hasattr(curr_user, "color") and curr_user.color is not None
                    has_official_profile_color = hasattr(curr_user, "profile_color") and curr_user.profile_color is not None
                    has_official_status = hasattr(curr_user, "emoji_status") and curr_user.emoji_status is not None

                    if is_real_premium or has_official_color or has_official_profile_color or has_official_status:
                        if not self.get_setting(f"slot_{acc}_configured", False):
                            self._set_slot_val(acc, "premium", True)
                            if has_official_color:
                                nc = int(getattr(curr_user.color, "color", 2) or 0)
                                if nc >= 0:
                                    self._set_slot_val(acc, "name_color", nc)
                                bg_em = getattr(curr_user.color, "background_emoji_id", 0)
                                if bg_em != 0:
                                    self._set_slot_val(acc, "name_bg_emoji_id", str(bg_em))

                            if has_official_profile_color:
                                prc = int(getattr(curr_user.profile_color, "color", 2) or 0)
                                if prc >= 0:
                                    self._set_slot_val(acc, "profile_color", prc)
                                p_bg_em = getattr(curr_user.profile_color, "background_emoji_id", 0)
                                if p_bg_em != 0:
                                    self._set_slot_val(acc, "profile_bg_emoji_id", str(p_bg_em))

                            if has_official_status:
                                doc_id = getattr(curr_user.emoji_status, "document_id", 0)
                                if doc_id != 0:
                                    self._set_slot_val(acc, "emoji_status_id", str(doc_id))

                            self.set_setting(f"slot_{acc}_configured", True, reload_settings=False)
                            imported_any = True
                            log(f"SyncProfile: Автоматически импортирован официальный TG Premium для аккаунта {acc + 1}")
                except Exception as e:
                    log(f"SyncProfile: Ошибка автоимпорта TG Premium для аккаунта {acc}: {e}")
        except Exception as e:
            log(f"SyncProfile: Ошибка автоимпорта: {e}")

        if imported_any:
            self._save_local_profiles_cache(force=True)

    def _get_my_active_uids(self) -> List[int]:
        uids = []
        try:
            from org.telegram.messenger import UserConfig
            for acc in range(4):
                try:
                    u_c = UserConfig.getInstance(acc)
                    if u_c and u_c.isClientActivated():
                        uid = int(u_c.getClientUserId() or 0)
                        if uid != 0 and uid not in uids:
                            uids.append(uid)
                except Exception:
                    pass
        except Exception:
            pass
        self._own_uids_cache = set(uids)
        return uids

    def _get_active_accounts_data(self, force: bool = False) -> List[Dict[str, Any]]:
        now = time.time()
        with self._sync_lock:
            if not force and self._cached_active_accs is not None and (now - self._cached_active_accs_time) < 300.0:
                return list(self._cached_active_accs)

        accounts = []
        try:
            from org.telegram.messenger import UserConfig
            selected = getattr(UserConfig, "selectedAccount", 0)
            max_accs = getattr(UserConfig, "MAX_ACCOUNT_COUNT", 4)
            for acc in range(max_accs):
                try:
                    u_cfg = UserConfig.getInstance(acc)
                    if not u_cfg:
                        continue

                    is_active = bool(u_cfg.isClientActivated())
                    curr_user = u_cfg.getCurrentUser()
                    uid = int(u_cfg.getClientUserId() or (getattr(curr_user, "id", 0) if curr_user else 0))

                    if is_active and uid > 0 and curr_user is not None:
                        fn = str(getattr(curr_user, "first_name", "") or "")
                        ln = str(getattr(curr_user, "last_name", "") or "")
                        uname = str(getattr(curr_user, "username", "") or "")
                        phone = str(getattr(curr_user, "phone", "") or "")

                        name = " ".join([p for p in [fn, ln] if p]).strip() or f"Аккаунт {acc + 1}"
                        extra = f"@{uname}" if uname else phone
                        extra_str = f" ({extra})" if extra else ""

                        is_curr = (acc == selected)
                        accounts.append({
                            "acc_idx": acc,
                            "user_id": uid,
                            "name": name,
                            "extra": extra_str,
                            "is_current": is_curr,
                        })
                except Exception:
                    pass
        except Exception:
            pass

        if not accounts:
            try:
                from org.telegram.messenger import UserConfig
                curr_user = UserConfig.getInstance(UserConfig.selectedAccount).getCurrentUser()
                uid = int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId() or (getattr(curr_user, "id", 0) if curr_user else 0))
                if uid > 0:
                    fn = str(getattr(curr_user, "first_name", "") or "") if curr_user else ""
                    ln = str(getattr(curr_user, "last_name", "") or "") if curr_user else ""
                    uname = str(getattr(curr_user, "username", "") or "") if curr_user else ""
                    name = " ".join([p for p in [fn, ln] if p]).strip() or "Мой аккаунт"
                    extra = f" (@{uname})" if uname else ""
                    accounts.append({
                        "acc_idx": UserConfig.selectedAccount,
                        "user_id": uid,
                        "name": name,
                        "extra": extra,
                        "is_current": True,
                    })
            except Exception:
                pass

        accounts.sort(key=lambda x: x["acc_idx"])
        with self._sync_lock:
            self._cached_active_accs = accounts
            self._cached_active_accs_time = now
            self._own_uids_cache = {acc["user_id"] for acc in accounts if acc.get("user_id", 0) > 0}
            self._own_slots_cache = {acc["user_id"]: acc["acc_idx"] for acc in accounts if acc.get("user_id", 0) > 0}
        return accounts

    def _get_slot_val(self, acc_idx: int, key: str, default: Any) -> Any:
        slot_key = f"slot_{acc_idx}_{key}"
        val = self.get_setting(slot_key, None)
        if val is not None and str(val).strip() != "":
            return val

        if acc_idx == 0:
            legacy_val = self.get_setting(f"my_{key}", None)
            if legacy_val is not None and str(legacy_val).strip() != "":
                return legacy_val

        return default

    def _sync_local_ayuconfig(self, acc_idx: Optional[int] = None):
        """В AyuGram параметры профиля AyuConfig настраиваются пользователем в клиенте.
        Плагин не перезаписывает AyuConfig, сохраняя нативную логику локального премиума."""
        pass

    def _set_slot_val(self, acc_idx: int, key: str, val: Any):
        slot_key = f"slot_{acc_idx}_{key}"
        self.set_setting(slot_key, val)
        self.set_setting(f"slot_{acc_idx}_configured", True, reload_settings=False)
        if acc_idx == 0:
            self.set_setting(f"my_{key}", val)
        self._sync_local_ayuconfig(acc_idx)

    def _get_profile_dict_for_slot(self, acc_idx: int, user_id: int) -> Dict[str, Any]:
        default_name_c = 0
        default_prof_c = 0

        name_c = _safe_int(self._get_slot_val(acc_idx, "name_color", default_name_c), default_name_c)
        if name_c < 0 or name_c >= len(NAME_AND_REPLY_COLORS):
            name_c = default_name_c

        name_bg = _safe_int(self._get_slot_val(acc_idx, "name_bg_emoji_id", DEFAULT_NAME_BG_EMOJI), 0)
        prof_c = _safe_int(self._get_slot_val(acc_idx, "profile_color", default_prof_c), default_prof_c)
        if prof_c < 0 or prof_c >= len(PROFILE_COLORS):
            prof_c = default_prof_c

        prof_bg = _safe_int(self._get_slot_val(acc_idx, "profile_bg_emoji_id", DEFAULT_PROFILE_BG_EMOJI), 0)
        em_id = _safe_int(self._get_slot_val(acc_idx, "emoji_status_id", DEFAULT_EMOJI_STATUS_ID), 0)
        prem = bool(self._get_slot_val(acc_idx, "premium", True))

        return {
            "user_id": user_id,
            "premium": prem,
            "emoji_status_id": em_id,
            "name_color": name_c,
            "name_bg_emoji_id": name_bg,
            "profile_color": prof_c,
            "profile_bg_emoji_id": prof_bg,
            "client_type": "AyuGram",
        }

    def get_cached_profile(self, uid: int) -> Optional[Dict[str, Any]]:
        if not uid or uid <= 0:
            return None
        snap = self._profiles_snapshot
        if snap:
            return snap.get(uid)
        with self._sync_lock:
            return self._profiles_cache.get(uid)

    def _update_snapshot(self):
        """Replace the lock-free snapshot with the current cache state.
        Safe for concurrent lock-free reads under CPython GIL."""
        self._cache_version += 1
        self._profiles_snapshot = dict(self._profiles_cache)
        self._chats_snapshot = dict(self._chats_cache)
        self._video_checked_uids.clear()
        self._video_checked_chat_ids.clear()
        self._handled_uids.clear()
        self._handled_cids.clear()

    def _update_snapshot_partial(self, updated_uids: Optional[Set[int]] = None, updated_cids: Optional[Set[int]] = None):
        """Инкрементальное обновление snapshot — только изменившиеся uid и cid.
        Для delta-sync: избегаем полного копирования dict при 1000+ профилях."""
        self._cache_version += 1

        # Обратная совместимость для вызова с одним позиционным аргументом-set
        if updated_cids is None and isinstance(updated_uids, set):
            pass

        if updated_uids:
            snap_p = dict(self._profiles_snapshot)
            for uid in updated_uids:
                p = self._profiles_cache.get(uid)
                if p is not None:
                    snap_p[uid] = p
                else:
                    snap_p.pop(uid, None)
                self._video_checked_uids.discard(uid)
                self._handled_uids.discard(uid)
            self._profiles_snapshot = snap_p

        if updated_cids:
            snap_c = dict(self._chats_snapshot)
            for cid in updated_cids:
                c = self._chats_cache.get(cid)
                if c is not None:
                    snap_c[cid] = c
                else:
                    snap_c.pop(cid, None)
                self._video_checked_chat_ids.discard(cid)
                self._handled_cids.discard(cid)
            self._chats_snapshot = snap_c

    def _parse_items_map(self, raw_data: Any, is_chat: bool = False) -> Dict[int, Dict[str, Any]]:
        result = {}
        if not raw_data:
            return result

        if isinstance(raw_data, list):
            for item in raw_data:
                if not isinstance(item, dict):
                    continue
                if is_chat:
                    k_id = _normalize_chat_id(item.get("chat_id") if "chat_id" in item else item.get("id"))
                else:
                    k_id = _safe_int(item.get("user_id") if "user_id" in item else item.get("id"))
                if k_id > 0:
                    result[k_id] = item
        elif isinstance(raw_data, dict):
            for k, v in raw_data.items():
                if isinstance(v, dict):
                    if is_chat:
                        k_id = _normalize_chat_id(v.get("chat_id") if "chat_id" in v else (v.get("id") if "id" in v else k))
                    else:
                        k_id = _safe_int(v.get("user_id") if "user_id" in v else (v.get("id") if "id" in v else k))
                    if k_id > 0:
                        result[k_id] = v
                else:
                    if is_chat:
                        k_id = _normalize_chat_id(k)
                    else:
                        k_id = _safe_int(k)
                    if k_id > 0:
                        result[k_id] = {"id": k_id, "data": v}

        return result

    def _patch_user_tl_object(self, u: Any) -> bool:
        if not u:
            return False

        # 1. Zero-JNI Fast-Path: мгновенная проверка Python-прокси кэша (~15 наносекунд)
        cur_ver = self._cache_version
        sp_v = getattr(u, "_sp_v", None)
        if sp_v is not None and isinstance(sp_v, tuple) and len(sp_v) == 2 and sp_v[0] == cur_ver:
            return bool(sp_v[1])

        # 2. Читаем ID пользователя (только при первом появлении Java-объекта в текущей версии кэша)
        try:
            uid = int(getattr(u, "id", 0) or 0)
        except Exception:
            return False

        if uid <= 0:
            try:
                u._sp_v = (cur_ver, 0)
            except Exception:
                pass
            return False

        # 3. O(1) поиск в lock-free снимке CPython dict
        snap = getattr(self, "_profiles_snapshot", None)
        profile = snap.get(uid) if snap else None
        if profile is None:
            with self._sync_lock:
                profile = self._profiles_cache.get(uid)

        # Если пользователя нет в базе SyncProfile — мгновенно запоминаем и выходим (0 JNI вызовов)
        if not profile:
            try:
                u._sp_v = (cur_ver, 0)
            except Exception:
                pass
            return False

        # Только для пользователей SyncProfile: проверка видеоаватарки
        if uid not in self._video_checked_uids:
            self._video_checked_uids.add(uid)
            ph = getattr(u, "photo", None)
            if ph is not None:
                try:
                    if not getattr(ph, "has_video", False):
                        fl = int(getattr(ph, "flags", 0) or 0)
                        if (fl & 1) != 0:
                            ph.has_video = True
                        else:
                            v_sizes = getattr(ph, "video_sizes", None)
                            if v_sizes is not None:
                                is_py_v = isinstance(v_sizes, list)
                                size = len(v_sizes) if is_py_v else (v_sizes.size() if hasattr(v_sizes, "size") else (len(v_sizes) if hasattr(v_sizes, "__len__") else 0))
                                if size > 0:
                                    ph.has_video = True
                                    ph.flags = fl | 1
                except Exception:
                    pass

        try:
            nc    = _safe_int(profile.get("name_color", 0))
            nbg   = _safe_int(profile.get("name_bg_emoji_id", 0))
            prc   = _safe_int(profile.get("profile_color", 0))
            pbg   = _safe_int(profile.get("profile_bg_emoji_id", 0))
            em_id = _safe_int(profile.get("emoji_status_id", 0))
            prem  = bool(profile.get("premium", True))

            cur_flags = int(getattr(u, "flags", 0) or 0)
            cur_flags2 = int(getattr(u, "flags2", 0) or 0)
            new_flags = cur_flags
            new_flags2 = cur_flags2

            # 1. Цвет имени и реплаев
            existing_color = getattr(u, "color", None)
            pc_obj = _build_peer_color(nc, nbg)
            if existing_color is not pc_obj:
                color_matches = (
                    existing_color is not None
                    and int(getattr(existing_color, "color", -1)) == nc
                    and int(getattr(existing_color, "background_emoji_id", 0)) == nbg
                )
                if not color_matches:
                    if pc_obj is not None:
                        u.color = pc_obj
                        new_flags2 |= 0x100  # FLAG_COLOR (1 << 8 в flags2 TLRPC.User)
                    else:
                        if existing_color is not None:
                            u.color = None
                        new_flags2 &= ~0x100

            # 2. Цвет профиля (фон карточки)
            existing_prof_color = getattr(u, "profile_color", None)
            prc_obj = _build_peer_color(prc, pbg)
            if existing_prof_color is not prc_obj:
                prof_color_matches = (
                    existing_prof_color is not None
                    and int(getattr(existing_prof_color, "color", -1)) == prc
                    and int(getattr(existing_prof_color, "background_emoji_id", 0)) == pbg
                )
                if not prof_color_matches:
                    if prc_obj is not None:
                        u.profile_color = prc_obj
                        new_flags2 |= 0x200  # FLAG_PROFILE_COLOR (1 << 9 в flags2 TLRPC.User)
                    else:
                        if existing_prof_color is not None:
                            u.profile_color = None
                        new_flags2 &= ~0x200

            # 3. Эмодзи-статус (рядом с именем)
            if em_id != 0:
                st_obj = _build_emoji_status(em_id)
                if st_obj is not None:
                    u.emoji_status = st_obj
                new_flags |= 0x40000000  # FLAG_EMOJI_STATUS (1 << 30 в flags TLRPC.User)
            else:
                if getattr(u, "emoji_status", None) is not None:
                    u.emoji_status = None
                new_flags &= ~0x40000000

            # 4. Премиум статус
            # ВАЖНО: для СВОИХ аккаунтов этот флаг не трогаем. Нативный движок AyuGram
            # (AyuConfig.localPremium) сам решает по РЕАЛЬНОМУ значению user.premium,
            # нужно ли маскировать кастомные эмодзи под tg://emoji-ссылку перед отправкой.
            # Если здесь подменить premium=True поверх настоящего не-Premium аккаунта,
            # AyuGram решит, что Premium настоящий, не применит свою маскировку —
            # и сервер Telegram срежет кастомный эмодзи прямо при отправке.
            is_own_account = uid in getattr(self, "_own_uids_cache", ())
            if not is_own_account:
                if prem:
                    if not getattr(u, "premium", False):
                        u.premium = True
                    new_flags |= 0x10000000  # FLAG_PREMIUM (1 << 28 в flags TLRPC.User)
                else:
                    new_flags &= ~0x10000000

            if new_flags != cur_flags:
                u.flags = new_flags
            if new_flags2 != cur_flags2:
                u.flags2 = new_flags2

            try:
                u._sp_v = (cur_ver, uid)
            except Exception:
                pass
            return True
        except Exception as e:
            logger.debug(f"_patch_user_tl_object error for uid={uid}: {e}")
            return False

    def _patch_full_user_tl_object(self, fu: Any, user_id: int) -> bool:
        if not fu:
            return False
        uid = int(user_id or getattr(fu, "id", 0) or 0)
        if uid <= 0:
            return False

        cur_ver = self._cache_version
        sp_v = getattr(fu, "_sp_v", None)
        if sp_v is not None and isinstance(sp_v, tuple) and len(sp_v) == 2 and sp_v[0] == cur_ver:
            return bool(sp_v[1])

        snap = getattr(self, "_profiles_snapshot", None)
        profile = snap.get(uid) if snap else None
        if profile is None:
            with self._sync_lock:
                profile = self._profiles_cache.get(uid)

        if not profile:
            try:
                fu._sp_v = (cur_ver, 0)
            except Exception:
                pass
            return False

        try:
            nc = _safe_int(profile.get("name_color", 0))
            nbg = _safe_int(profile.get("name_bg_emoji_id", 0))
            prc = _safe_int(profile.get("profile_color", 0))
            pbg = _safe_int(profile.get("profile_bg_emoji_id", 0))
            em_id = _safe_int(profile.get("emoji_status_id", 0))

            prc_obj = _build_peer_color(prc, pbg)
            if prc_obj is not None:
                fu.profile_color = prc_obj

            nc_obj = _build_peer_color(nc, nbg)
            if nc_obj is not None:
                fu.color = nc_obj

            if em_id != 0:
                st_obj = _build_emoji_status(em_id)
                if st_obj is not None:
                    try:
                        fu.custom_status = st_obj
                    except Exception:
                        pass
                    try:
                        fu.emoji_status = st_obj
                    except Exception:
                        pass
                    cur_fu_flags = int(getattr(fu, "flags", 0) or 0)
                    fu.flags = cur_fu_flags | 0x80000  # 1 << 19: custom_status in UserFull

            fu_user = getattr(fu, "user", None)
            if fu_user and _is_user(fu_user):
                self._patch_user_tl_object(fu_user)

            try:
                fu._sp_v = (cur_ver, uid)
            except Exception:
                pass
            return True
        except Exception as e:
            logger.debug(f"_patch_full_user_tl_object error for uid={uid}: {e}")
            return False

    def _patch_chat_tl_object(self, chat: Any) -> bool:
        if not chat:
            return False

        # 1. Zero-JNI Fast-Path: мгновенная проверка Python-прокси кэша (~15 наносекунд)
        cur_ver = self._cache_version
        sp_v = getattr(chat, "_sp_v", None)
        if sp_v is not None and isinstance(sp_v, tuple) and len(sp_v) == 2 and sp_v[0] == cur_ver:
            return bool(sp_v[1])

        try:
            raw_id = getattr(chat, "id", 0)
            cid = _normalize_chat_id(raw_id)
        except Exception:
            return False

        if cid <= 0:
            try:
                chat._sp_v = (cur_ver, 0)
            except Exception:
                pass
            return False

        # 2. Instant Fast-Path: 99% чатов/каналов отсутствуют в базе SyncProfile (~30ns)
        snap = getattr(self, "_chats_snapshot", None)
        profile = snap.get(cid) if snap else None
        if profile is None:
            with self._sync_lock:
                profile = self._chats_cache.get(cid)

        if not profile:
            try:
                chat._sp_v = (cur_ver, 0)
            except Exception:
                pass
            return False

        # Только для чатов SyncProfile:
        if cid not in self._video_checked_chat_ids:
            ph = getattr(chat, "photo", None)
            if ph is not None:
                try:
                    if not getattr(ph, "has_video", False):
                        fl = int(getattr(ph, "flags", 0) or 0)
                        if (fl & 1) != 0:
                            ph.has_video = True
                        else:
                            v_sizes = getattr(ph, "video_sizes", None)
                            if v_sizes is not None:
                                size = len(v_sizes) if isinstance(v_sizes, list) else (v_sizes.size() if hasattr(v_sizes, "size") else len(v_sizes))
                                if size > 0:
                                    ph.has_video = True
                                    ph.flags = fl | 1
                except Exception:
                    pass
            self._video_checked_chat_ids.add(cid)

        try:
            nc        = _safe_int(profile.get("name_color", 0))
            nbg       = _safe_int(profile.get("name_bg_emoji_id", 0))
            prc       = _safe_int(profile.get("profile_color", 0))
            pbg       = _safe_int(profile.get("profile_bg_emoji_id", 0))
            em_id     = _safe_int(profile.get("emoji_status_id", 0))
            boost_lvl = _safe_int(profile.get("boost_level", 0))

            cur_flags = int(getattr(chat, "flags", 0) or 0)
            cur_flags2 = int(getattr(chat, "flags2", 0) or 0)
            new_flags = cur_flags
            new_flags2 = cur_flags2

            # 1. Цвет имени канала/чата
            existing_color = getattr(chat, "color", None)
            pc_obj = _build_peer_color(nc, nbg)
            if existing_color is not pc_obj:
                color_matches = (
                    existing_color is not None
                    and int(getattr(existing_color, "color", -1)) == nc
                    and int(getattr(existing_color, "background_emoji_id", 0)) == nbg
                )
                if not color_matches:
                    if pc_obj is not None:
                        chat.color = pc_obj
                        new_flags2 |= 128  # FLAG2_COLOR для каналов (1 << 7)
                    else:
                        if existing_color is not None:
                            chat.color = None
                        new_flags2 &= ~128

            # 2. Цвет обложки канала/чата
            existing_prc = getattr(chat, "profile_color", None)
            prc_obj = _build_peer_color(prc, pbg)
            if existing_prc is not prc_obj:
                prc_matches = (
                    existing_prc is not None
                    and int(getattr(existing_prc, "color", -1)) == prc
                    and int(getattr(existing_prc, "background_emoji_id", 0)) == pbg
                )
                if not prc_matches:
                    if prc_obj is not None:
                        chat.profile_color = prc_obj
                        new_flags2 |= 256  # FLAG2_PROFILE_COLOR для каналов (1 << 8)
                    else:
                        if existing_prc is not None:
                            chat.profile_color = None
                        new_flags2 &= ~256

            # 3. Эмодзи-статус (только для каналов и супергрупп)
            if em_id != 0:
                st_obj = _build_emoji_status(em_id)
                if st_obj is not None:
                    chat.emoji_status = st_obj
                new_flags |= 512    # flags.9 для каналов (1 << 9)
                new_flags2 |= 1     # flags2.0 для emoji_status (1 << 0)
            else:
                if getattr(chat, "emoji_status", None) is not None:
                    chat.emoji_status = None
                new_flags &= ~512
                new_flags2 &= ~1

            if boost_lvl > 0:
                chat.level = boost_lvl

            if new_flags != cur_flags:
                chat.flags = new_flags
            if new_flags2 != cur_flags2:
                chat.flags2 = new_flags2

            try:
                chat._sp_v = (cur_ver, cid)
            except Exception:
                pass
            return True
        except Exception as e:
            logger.debug(f"_patch_chat_tl_object error for cid={cid}: {e}")
            return False

    def _patch_full_chat_tl_object(self, fc: Any, chat_id: int) -> bool:
        if not fc:
            return False
        cid = _normalize_chat_id(chat_id or getattr(fc, "id", 0))
        if cid <= 0:
            return False

        cur_ver = self._cache_version
        sp_v = getattr(fc, "_sp_v", None)
        if sp_v is not None and isinstance(sp_v, tuple) and len(sp_v) == 2 and sp_v[0] == cur_ver:
            return bool(sp_v[1])

        snap = getattr(self, "_chats_snapshot", None)
        profile = snap.get(cid) if snap else None
        if profile is None:
            with self._sync_lock:
                profile = self._chats_cache.get(cid)

        if not profile:
            try:
                fc._sp_v = (cur_ver, 0)
            except Exception:
                pass
            return False

        try:
            nc = _safe_int(profile.get("name_color", 0))
            nbg = _safe_int(profile.get("name_bg_emoji_id", 0))
            prc = _safe_int(profile.get("profile_color", 0))
            pbg = _safe_int(profile.get("profile_bg_emoji_id", 0))
            em_id = _safe_int(profile.get("emoji_status_id", 0))
            boost_lvl = _safe_int(profile.get("boost_level", 0))

            prc_obj = _build_peer_color(prc, pbg)
            if prc_obj is not None:
                fc.profile_color = prc_obj

            nc_obj = _build_peer_color(nc, nbg)
            if nc_obj is not None:
                fc.color = nc_obj

            if em_id != 0:
                st_obj = _build_emoji_status(em_id)
                if st_obj is not None:
                    fc.custom_status = st_obj
                    fc.emoji_status = st_obj
                    cur_fc_flags = int(getattr(fc, "flags", 0) or 0)
                    fc.flags = cur_fc_flags | 512

            if boost_lvl > 0:
                fc.boosts_applied = boost_lvl

            fc_chat = getattr(fc, "chat", None)
            if fc_chat and _is_chat(fc_chat):
                self._patch_chat_tl_object(fc_chat)

            try:
                fc._sp_v = (cur_ver, cid)
            except Exception:
                pass
            return True
        except Exception as e:
            logger.debug(f"_patch_full_chat_tl_object error for cid={cid}: {e}")
            return False

    def _refresh_loaded_telegram_objects(self):
        """Проактивно обновляет уже загруженные в память MessagesController
        объекты пользователей и чатов, присутствующих в базе SyncProfile (O(K_profiles), <0.05 мс).
        Вызывается на UI-потоке после загрузки кэша или завершения синхронизации."""
        try:
            from org.telegram.messenger import MessagesController, UserConfig
            snap_profiles = getattr(self, "_profiles_snapshot", None)
            snap_chats = getattr(self, "_chats_snapshot", None)
            if not snap_profiles and not snap_chats:
                return

            max_acc = getattr(UserConfig, "MAX_ACCOUNT_COUNT", 4)
            for acc_idx in range(max_acc):
                try:
                    u_cfg = UserConfig.getInstance(acc_idx)
                    if not u_cfg or not u_cfg.isClientActivated():
                        continue
                    mc = MessagesController.getInstance(acc_idx)
                    if not mc:
                        continue

                    if snap_profiles:
                        users_map = getattr(mc, "users", None)
                        for uid in list(snap_profiles.keys()):
                            try:
                                u = None
                                if users_map is not None:
                                    try:
                                        from java.lang import Long as _JLong
                                        u = users_map.get(_JLong(int(uid)))
                                    except Exception:
                                        try:
                                            u = users_map.get(int(uid))
                                        except Exception:
                                            pass
                                if u is None:
                                    u = self._safe_get_user(mc, int(uid))
                                if u is not None:
                                    self._patch_user_tl_object(u)
                            except Exception:
                                pass

                    if snap_chats:
                        chats_map = getattr(mc, "chats", None)
                        for cid in list(snap_chats.keys()):
                            try:
                                c = None
                                if chats_map is not None:
                                    try:
                                        from java.lang import Long as _JLong
                                        c = chats_map.get(_JLong(int(cid)))
                                    except Exception:
                                        try:
                                            c = chats_map.get(int(cid))
                                        except Exception:
                                            pass
                                if c is None:
                                    try:
                                        from java.lang import Long as _JLong
                                        c = mc.getChat(_JLong(int(cid)))
                                    except Exception:
                                        try:
                                            c = mc.getChat(int(cid))
                                        except Exception:
                                            pass
                                if c is not None:
                                    self._patch_chat_tl_object(c)
                            except Exception:
                                pass
                except Exception:
                    pass
        except Exception as e:
            logger.debug(f"_refresh_loaded_telegram_objects error: {e}")

    def _show_profile_bulletin_if_sync_user(self, fragment: Any):
        """Показывает всплывающее меню/плашку снизу (Bulletin) при открытии профиля пользователя или чата SyncProfile
        и гарантированно JIT-патчит объекты карточки профиля."""
        if not fragment:
            return

        target_id = 0
        try:
            # 1. Извлекаем ID: прямой dialog_id (или user_id/userId)
            did = getattr(fragment, "dialog_id", None)
            if did is not None:
                try:
                    target_id = int(did)
                except Exception:
                    pass
            if target_id == 0:
                uid_attr = getattr(fragment, "user_id", None) or getattr(fragment, "userId", None)
                if uid_attr is not None:
                    try:
                        target_id = int(uid_attr)
                    except Exception:
                        pass
        except Exception:
            pass

        # 2. Fast-Path JIT patch объектов ProfileActivity
        try:
            if target_id > 0:
                u = getattr(fragment, "currentUser", None)
                if u is not None:
                    self._patch_user_tl_object(u)
                fu = getattr(fragment, "userInfo", None)
                if fu is not None:
                    self._patch_full_user_tl_object(fu, target_id)
            elif target_id < 0:
                cid = _normalize_chat_id(abs(target_id))
                c = getattr(fragment, "currentChat", None)
                if c is not None:
                    self._patch_chat_tl_object(c)
                fc = getattr(fragment, "chatInfo", None)
                if fc is not None:
                    self._patch_full_chat_tl_object(fc, cid)
            else:
                u = getattr(fragment, "currentUser", None)
                if u is not None:
                    self._patch_user_tl_object(u)
                    uid = int(getattr(u, "id", 0) or 0)
                    if uid > 0:
                        target_id = uid
                        fu = getattr(fragment, "userInfo", None)
                        if fu is not None:
                            self._patch_full_user_tl_object(fu, uid)
                else:
                    c = getattr(fragment, "currentChat", None)
                    if c is not None:
                        self._patch_chat_tl_object(c)
                        cid = _normalize_chat_id(getattr(c, "id", 0) or 0)
                        if cid > 0:
                            target_id = -cid
                            fc = getattr(fragment, "chatInfo", None)
                            if fc is not None:
                                self._patch_full_chat_tl_object(fc, cid)
        except Exception as e:
            logger.debug(f"_show_profile_bulletin_if_sync_user JIT patch error: {e}")

        # 3. Показ Bulletin
        if not self.get_setting("show_syncprofile_badge_in_about", True) or target_id == 0:
            return

        try:
            now = time.time()
            last_target, last_time = getattr(self, "_last_shown_bulletin", (0, 0.0))
            if last_target == target_id and (now - last_time) < 10.0:
                return

            is_user = target_id > 0
            uid = target_id if is_user else 0
            cid = _normalize_chat_id(abs(target_id)) if not is_user else 0

            has_sync = False
            if uid > 0:
                snap_p = getattr(self, "_profiles_snapshot", None)
                own_uids = getattr(self, "_own_uids_cache", None) or set()
                has_sync = (snap_p is not None and uid in snap_p) or (uid in own_uids)
            elif cid > 0:
                snap_c = getattr(self, "_chats_snapshot", None)
                has_sync = (snap_c is not None and cid in snap_c)

            if has_sync:
                self._last_shown_bulletin = (target_id, now)
                msg = "⚡ Этот пользователь использует SyncProfile" if is_user else "⚡ Этот чат/канал использует SyncProfile"
                bulletins.show_info(msg)
        except Exception as e:
            logger.debug(f"_show_profile_bulletin_if_sync_user error: {e}")

    @staticmethod
    def _safe_get_user(mc: Any, uid: int) -> Any:
        """Вызывает mc.getUser() с явным java.lang.Long чтобы избежать
        ClassCastException (Long cannot be cast to Integer) в NotificationCenter.
        Chaquopy выбирает перегрузку по типу аргумента: Python int → Long;
        некоторые версии Telegram ожидают long-примитив, другие — Integer.
        Передача Long гарантирует совместимость с long-перегрузкой."""
        try:
            from java.lang import Long as _JLong
            return mc.getUser(_JLong(uid))
        except Exception:
            try:
                return mc.getUser(uid)
            except Exception:
                return None

    # ─────────────────────────────────────────────────────────────────────────

    def _register_xposed_hooks(self):
        """Регистрирует безопасные хуки на MessagesController, ProfileActivity и ChatActivity."""
        try:
            plugin_self = self
            MessagesControllerClass = find_class("org.telegram.messenger.MessagesController")

            if MessagesControllerClass:
                class PutUserHook(MethodHook):
                    def before_hooked_method(self, param):
                        try:
                            args = getattr(param, "args", None)
                            if args and len(args) > 0:
                                u = args[0]
                                if u is not None:
                                    plugin_self._patch_user_tl_object(u)
                        except Exception as e:
                            logger.debug(f"PutUserHook error: {e}")

                class PutChatHook(MethodHook):
                    def before_hooked_method(self, param):
                        try:
                            args = getattr(param, "args", None)
                            if args and len(args) > 0:
                                c = args[0]
                                if c is not None:
                                    plugin_self._patch_chat_tl_object(c)
                        except Exception as e:
                            logger.debug(f"PutChatHook error: {e}")

                class PutUsersHook(MethodHook):
                    def before_hooked_method(self, param):
                        try:
                            args = getattr(param, "args", None)
                            if args and len(args) > 0:
                                users = args[0]
                                if users is not None:
                                    try:
                                        for u in users:
                                            if u is not None:
                                                plugin_self._patch_user_tl_object(u)
                                    except TypeError:
                                        u_count = users.size() if hasattr(users, "size") else len(users)
                                        for i in range(u_count):
                                            u = users.get(i)
                                            if u is not None:
                                                plugin_self._patch_user_tl_object(u)
                        except Exception as e:
                            logger.debug(f"PutUsersHook error: {e}")

                class PutChatsHook(MethodHook):
                    def before_hooked_method(self, param):
                        try:
                            args = getattr(param, "args", None)
                            if args and len(args) > 0:
                                chats = args[0]
                                if chats is not None:
                                    try:
                                        for c in chats:
                                            if c is not None:
                                                plugin_self._patch_chat_tl_object(c)
                                    except TypeError:
                                        c_count = chats.size() if hasattr(chats, "size") else len(chats)
                                        for i in range(c_count):
                                            c = chats.get(i)
                                            if c is not None:
                                                plugin_self._patch_chat_tl_object(c)
                        except Exception as e:
                            logger.debug(f"PutChatsHook error: {e}")

                class GetUserFullHook(MethodHook):
                    def after_hooked_method(self, param):
                        try:
                            args = getattr(param, "args", None)
                            if not args or len(args) == 0 or args[0] is None:
                                return
                            try:
                                uid = int(args[0])
                            except Exception:
                                return
                            if uid <= 0:
                                return
                            if uid not in plugin_self._profiles_snapshot and uid not in plugin_self._own_uids_cache:
                                return

                            fu_obj = param.getResult()
                            if fu_obj is not None:
                                uid_obj = getattr(fu_obj, "id", 0)
                                if uid_obj:
                                    plugin_self._patch_full_user_tl_object(fu_obj, int(uid_obj))
                        except Exception as e:
                            logger.debug(f"GetUserFullHook error: {e}")

                class GetChatFullHook(MethodHook):
                    def after_hooked_method(self, param):
                        try:
                            args = getattr(param, "args", None)
                            if not args or len(args) == 0 or args[0] is None:
                                return
                            try:
                                cid = _normalize_chat_id(args[0])
                            except Exception:
                                return
                            if cid <= 0:
                                return
                            if cid not in plugin_self._chats_snapshot:
                                return

                            fc_obj = param.getResult()
                            if fc_obj is not None:
                                cid_obj = getattr(fc_obj, "id", 0)
                                if cid_obj:
                                    plugin_self._patch_full_chat_tl_object(fc_obj, int(cid_obj))
                        except Exception as e:
                            logger.debug(f"GetChatFullHook error: {e}")

                methods = _get_class_methods(MessagesControllerClass)
                MC_TARGET_NAMES = {"putUser", "putChat", "putUsers", "putChats", "getUserFull", "getChatFull"}

                for m in methods:
                    try:
                        m_name = m.getName()
                        if m_name not in MC_TARGET_NAMES:
                            continue

                        p_types = m.getParameterTypes()
                        num_params = len(p_types)
                        if num_params == 0:
                            continue

                        if m_name == "putUser":
                            m.setAccessible(True)
                            unhook = self.hook_method(m, PutUserHook())
                            if unhook:
                                self._xposed_unhooks.append(unhook)
                        elif m_name == "putChat":
                            m.setAccessible(True)
                            unhook = self.hook_method(m, PutChatHook())
                            if unhook:
                                self._xposed_unhooks.append(unhook)
                        elif m_name == "putUsers":
                            m.setAccessible(True)
                            unhook = self.hook_method(m, PutUsersHook())
                            if unhook:
                                self._xposed_unhooks.append(unhook)
                        elif m_name == "putChats":
                            m.setAccessible(True)
                            unhook = self.hook_method(m, PutChatsHook())
                            if unhook:
                                self._xposed_unhooks.append(unhook)
                        elif m_name == "getUserFull":
                            m.setAccessible(True)
                            unhook = self.hook_method(m, GetUserFullHook())
                            if unhook:
                                self._xposed_unhooks.append(unhook)
                        elif m_name == "getChatFull":
                            m.setAccessible(True)
                            unhook = self.hook_method(m, GetChatFullHook())
                            if unhook:
                                self._xposed_unhooks.append(unhook)
                    except Exception as e:
                        logger.debug(f"SyncProfile: hook MessagesController method {m} error: {e}")

            # ── Hook ProfileActivity: добавление плашки SyncProfile в карточку профиля ──
            ProfileActivityClass = find_class("org.telegram.ui.ProfileActivity")
            if ProfileActivityClass:
                class ProfileActivityHook(MethodHook):
                    def after_hooked_method(self_hook, param):
                        try:
                            this_frag = getattr(param, "thisObject", None)
                            if this_frag:
                                plugin_self._show_profile_bulletin_if_sync_user(this_frag)
                        except Exception as e:
                            logger.debug(f"ProfileActivityHook error: {e}")

                for m in _get_class_methods(ProfileActivityClass):
                    try:
                        m_name = m.getName()
                        if m_name == "onResume":
                            m.setAccessible(True)
                            un = self.hook_method(m, ProfileActivityHook())
                            if un:
                                self._xposed_unhooks.append(un)
                    except Exception as e:
                        logger.debug(f"Hook ProfileActivity error: {e}")

            # ── Hook ChatActivity & ChatMessageCell: контекстное меню для ID эмодзи ──
            # ── Hook ChatMessageCell: контекстное меню для ID эмодзи ──
            ChatMessageCellClass = find_class("org.telegram.ui.Cells.ChatMessageCell")
            if ChatMessageCellClass:
                class ChatMessageCellMenuHook(MethodHook):
                    def before_hooked_method(self, param):
                        try:
                            this_obj = getattr(param, "thisObject", None)
                            if this_obj is not None:
                                mo = getattr(this_obj, "currentMessageObject", None) or getattr(this_obj, "messageObject", None)
                                plugin_self._last_selected_message = mo if mo is not None else this_obj
                            elif getattr(param, "args", None):
                                plugin_self._last_selected_message = param.args[0]
                        except Exception as e:
                            logger.debug(f"ChatMessageCellMenuHook error: {e}")

                for m in _get_class_methods(ChatMessageCellClass):
                    try:
                        m_name = m.getName()
                        if m_name in ("showMenu", "openMenu", "createActionsMenu"):
                            m.setAccessible(True)
                            un = self.hook_method(m, ChatMessageCellMenuHook())
                            if un:
                                self._xposed_unhooks.append(un)
                    except Exception as e:
                        logger.debug(f"Hook ChatMessageCell error: {e}")

            log(f"SyncProfile: Установлено {len(self._xposed_unhooks)} хуков.")
        except Exception as e:
            logger.error(f"SyncProfile: Ошибка регистрации хуков: {e}")

    def _unregister_xposed_hooks(self):
        for unhook in self._xposed_unhooks:
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self._xposed_unhooks.clear()

    def _initial_background_sync(self):
        # 0.5s — достаточно чтобы UI успел отрисовать первый кадр,
        # но намного меньше чем 1.0s чтобы snapshot был готов до первого getUser().
        time.sleep(0.5)
        if not self._is_running:
            return
        if self.get_setting("enable_sync", True):
            self.sync_delta_updates_from_server(show_bulletin=False)

    async def _async_initial_background_sync(self):
        await asyncio.sleep(0.5)
        if not self._is_running:
            return
        if self.get_setting("enable_sync", True):
            await self._async_sync_delta_updates(show_bulletin=False)

    @staticmethod
    def _trim_cache(cache: dict, max_size: int):
        """Баг 4: LRU-like trim — удаляем старые записи если кэш вырос сверх лимита.
        Простой FIFO (dict сохраняет порядок вставки с Python 3.7+)."""
        if len(cache) > max_size:
            overflow = len(cache) - max_size
            try:
                keys_to_del = list(cache.keys())[:overflow]
                for k in keys_to_del:
                    cache.pop(k, None)
            except Exception:
                pass

    def _get_sync_interval_seconds(self) -> int:
        idx = _safe_int(self.get_setting("auto_sync_interval", 1), 1)
        intervals = [60, 120, 300, 600, 900]
        if 0 <= idx < len(intervals):
            return intervals[idx]
        return 120

    def _trim_memory_caches(self):
        """Периодическая очистка кэшей памяти для предотвращения утечек при долгой сессии."""
        global _PATCHED_MSGS, _USER_CLASS_CACHE, _CHAT_CLASS_CACHE, _FIND_CLASS_CACHE
        self._trim_cache(_emoji_status_cache, 200)
        self._trim_cache(_peer_color_cache, 200)
        self._trim_cache(_EMOJI_DOC_ID_CACHE, 500)
        if len(self._video_checked_uids) > 1000:
            self._video_checked_uids = set()
            self._video_avatar_uids = set()
        if len(self._video_checked_chat_ids) > 500:
            self._video_checked_chat_ids = set()
        if len(self._handled_uids) > 1000:
            self._handled_uids = set()
        if len(self._handled_cids) > 500:
            self._handled_cids = set()
        if len(_PATCHED_MSGS) > 2000:
            _PATCHED_MSGS = set()
        if len(_USER_CLASS_CACHE) > 100:
            _USER_CLASS_CACHE = {}
        if len(_CHAT_CLASS_CACHE) > 100:
            _CHAT_CLASS_CACHE = {}
        if len(_FIND_CLASS_CACHE) > 200:
            _FIND_CLASS_CACHE = {}

    def _keep_alive_sync_loop(self):
        """Синхронный keep-alive loop. Использует threading.Event.wait() вместо
        time.sleep() — немедленно прерывается при вызове on_plugin_unload."""
        while self._is_running:
            base_interval = self._get_sync_interval_seconds()
            wait_secs = min(base_interval * (2 ** self._consecutive_errors), 900)
            stopped = self._stop_event.wait(timeout=wait_secs)
            if stopped or not self._is_running:
                break
            if self.get_setting("enable_sync", True):
                try:
                    self.sync_delta_updates_from_server(show_bulletin=False)
                    self._consecutive_errors = 0
                except Exception:
                    self._consecutive_errors = min(self._consecutive_errors + 1, 3)
            self._trim_memory_caches()

    async def _async_keep_alive_sync_loop(self):
        """Async keep-alive loop с настраиваемым интервалом автообновления."""
        while self._is_running:
            base_interval = self._get_sync_interval_seconds()
            wait_secs = min(base_interval * (2 ** self._consecutive_errors), 900)
            await asyncio.sleep(wait_secs)
            if not self._is_running:
                break
            if self.get_setting("enable_sync", True):
                try:
                    await self._async_sync_delta_updates(show_bulletin=False)
                    self._consecutive_errors = 0
                except Exception:
                    self._consecutive_errors = min(self._consecutive_errors + 1, 3)
            self._trim_memory_caches()

    def _api_request(
        self,
        method: str,
        path: str,
        payload: Optional[Dict[str, Any]] = None,
        custom_headers: Optional[Dict[str, str]] = None,
        timeout: float = 8.0,
        retries: int = 0,
        backoff_factor: float = 0.5,
    ) -> Tuple[int, Optional[Any], Optional[str]]:
        """Единый метод выполнения HTTP-запросов к серверу синхронизации с retry и backoff.
        Возвращает кортеж: (status_code, parsed_data_or_none, error_message_or_none).
        """
        if ALLOW_CUSTOM_SERVER_CONFIG:
            server_url = self.get_setting("server_url", DEFAULT_SERVER_URL).rstrip("/")
            cookie_val = self.get_setting("custom_cookie", DEFAULT_SECRET_COOKIE).strip()
        else:
            server_url = DEFAULT_SERVER_URL.rstrip("/")
            cookie_val = DEFAULT_SECRET_COOKIE.strip()
        url = f"{server_url}/{path.lstrip('/')}"

        headers = {
            "User-Agent": f"SyncProfile/{__version__}",
            "Cookie": f"{COOKIE_NAME}={cookie_val}",
        }
        if custom_headers:
            headers.update(custom_headers)

        data_bytes = None
        if payload is not None:
            data_bytes = json.dumps(payload).encode("utf-8")
            headers["Content-Type"] = "application/json"

        attempt = 0
        max_attempts = max(1, retries + 1)
        last_error = None

        while attempt < max_attempts:
            attempt += 1
            try:
                req = urllib.request.Request(url, data=data_bytes, headers=headers, method=method.upper())
                with urllib.request.urlopen(req, timeout=timeout) as resp:
                    status = resp.status
                    body = resp.read().decode("utf-8")
                    parsed = None
                    if body.strip():
                        try:
                            parsed = json.loads(body)
                        except Exception:
                            parsed = body
                    return (status, parsed, None)
            except urllib.error.HTTPError as he:
                last_error = f"HTTP {he.code}"
                logger.debug(f"_api_request {method} {url} HTTP error: {he.code}")
                # HTTP 304, 400, 401, 403, 404 не требуют повтора
                if he.code in (304, 400, 401, 403, 404):
                    return (he.code, None, last_error)
                if attempt < max_attempts:
                    time.sleep(backoff_factor * (2 ** (attempt - 1)))
            except Exception as e:
                last_error = str(e)
                logger.debug(f"_api_request {method} {url} error (attempt {attempt}/{max_attempts}): {e}")
                if attempt < max_attempts:
                    time.sleep(backoff_factor * (2 ** (attempt - 1)))

        return (0, None, last_error or "Network error")

    def _sync_database_action(self, view: Any = None):
        if HAS_ZWYLIB:
            async_manager.run_task(self._async_sync_database(show_bulletin=True, force_clean=False))
        else:
            threading.Thread(
                target=self._sync_database,
                kwargs={"show_bulletin": True, "force_clean": False},
                daemon=True,
            ).start()

    async def _async_sync_database(self, show_bulletin: bool = False, force_clean: bool = True):
        loop = asyncio.get_running_loop()
        await loop.run_in_executor(
            None,
            lambda: self._sync_database(show_bulletin=show_bulletin, force_clean=force_clean)
        )

    def _sync_database(self, show_bulletin: bool = False, force_clean: bool = True):
        with self._sync_op_lock:
            if self._sync_in_progress:
                if show_bulletin:
                    bulletins.show_info("Синхронизация уже выполняется...")
                return
            self._sync_in_progress = True

        try:
            headers = {}
            last_ts = self.get_setting("_last_sync_timestamp", 0)
            if not force_clean and last_ts > 0:
                headers["If-Modified-Since"] = str(last_ts)

            status, data, err = self._api_request(
                "GET",
                "api/profiles/all",
                custom_headers=headers if headers else None,
                timeout=8.0,
                retries=1,
                backoff_factor=1.0,
            )

            if status == 304:
                if show_bulletin:
                    bulletins.show_info("Синхронизация: База данных уже актуальна.")
                return

            if status == 200 and data is not None:
                profiles_map = self._parse_items_map(data.get("profiles", data.get("data", data)) if isinstance(data, dict) else data, is_chat=False)
                chats_map = self._parse_items_map(data.get("chats", {}) if isinstance(data, dict) else {}, is_chat=True)
                server_ts = (data.get("sync_time") or data.get("server_time") or data.get("timestamp")) if isinstance(data, dict) else int(time.time())

                with self._sync_lock:
                    if force_clean:
                        my_uids = self._get_my_active_uids()
                        preserved = {uid: p for uid, p in self._profiles_cache.items() if uid in my_uids}
                        self._profiles_cache = preserved
                        self._chats_cache.clear()

                    for uid, p in profiles_map.items():
                        self._profiles_cache[uid] = p

                    for cid, c in chats_map.items():
                        self._chats_cache[cid] = c

                    self._cache_dirty = True

                self._video_checked_uids.clear()
                self._video_checked_chat_ids.clear()
                self._update_snapshot()
                self.set_setting("_last_sync_timestamp", server_ts, reload_settings=False)
                self._save_local_profiles_cache()
                run_on_ui_thread(self._refresh_loaded_telegram_objects)

                if show_bulletin:
                    bulletins.show_success(f"База обновлена! Загружено профилей: {len(profiles_map)}")
                return

            if show_bulletin:
                if status == 401:
                    bulletins.show_error("Ошибка 401: Доступ к серверу синхронизации ограничен.")
                elif status == 403:
                    bulletins.show_error("Ошибка 403: Доступ запрещён.")
                elif status > 0:
                    bulletins.show_error(f"Сервер ответил кодом: {status}")
                else:
                    bulletins.show_error(f"Ошибка загрузки базы: {err or 'Неизвестная ошибка'}")
        except Exception as e:
            logger.error(f"Sync database error: {e}")
            if show_bulletin:
                bulletins.show_error(f"Ошибка загрузки базы: {e}")
        finally:
            with self._sync_op_lock:
                self._sync_in_progress = False

    def sync_delta_updates_from_server(self, show_bulletin: bool = True):
        threading.Thread(target=self._sync_delta_worker, args=(show_bulletin,), daemon=True).start()

    async def _async_sync_delta_updates(self, show_bulletin: bool = False):
        loop = asyncio.get_running_loop()
        await loop.run_in_executor(None, lambda: self._sync_delta_worker(show_bulletin))

    def _sync_delta_worker(self, show_bulletin: bool):
        with self._sync_op_lock:
            if self._sync_in_progress:
                return
            self._sync_in_progress = True

        try:
            last_ts = self.get_setting("_last_sync_timestamp", 0)
            status, data, err = self._api_request(
                "GET",
                f"api/profiles/updates?since={last_ts}",
                timeout=6.0,
                retries=1,
                backoff_factor=1.0,
            )

            if status == 304:
                if show_bulletin:
                    bulletins.show_info("Изменений нет — профили актуальны.")
                return

            if status == 200 and data is not None:
                profiles_map = self._parse_items_map(data.get("profiles", data.get("data", data)) if isinstance(data, dict) else data, is_chat=False)
                chats_map = self._parse_items_map(data.get("chats", {}) if isinstance(data, dict) else {}, is_chat=True)
                new_ts = (data.get("sync_time") or data.get("server_time") or data.get("timestamp")) if isinstance(data, dict) else int(time.time())

                if profiles_map or chats_map:
                    with self._sync_lock:
                        for u_id, p in profiles_map.items():
                            self._profiles_cache[u_id] = p
                            self._cache_dirty = True
                        for c_id, c in chats_map.items():
                            self._chats_cache[c_id] = c
                            self._cache_dirty = True

                    self._update_snapshot_partial(updated_uids=set(profiles_map.keys()), updated_cids=set(chats_map.keys()))
                    self.set_setting("_last_sync_timestamp", new_ts, reload_settings=False)
                    self._save_local_profiles_cache()
                    run_on_ui_thread(self._refresh_loaded_telegram_objects)

                    if show_bulletin:
                        bulletins.show_success(f"Получено обновлений: {len(profiles_map)} профилей, {len(chats_map)} чатов!")
                else:
                    self.set_setting("_last_sync_timestamp", new_ts, reload_settings=False)
                    if show_bulletin:
                        bulletins.show_info("Изменений нет — профили актуальны.")
            else:
                if show_bulletin and err:
                    bulletins.show_error(f"Ошибка проверки обновлений: {err}")
        except Exception as e:
            logger.debug(f"Delta sync error: {e}")
            if show_bulletin:
                bulletins.show_error(f"Ошибка синхронизации: {e}")
        finally:
            with self._sync_op_lock:
                self._sync_in_progress = False

    def _apply_all_to_all_accounts(self):
        """Обновляет TL-объекты собственных аккаунтов (цвет, premium, эмодзи).
        Тяжёлая работа (чтение настроек) — в background-потоке.
        UI-часть: только getCurrentUser() + прямая запись полей.
        mc.getUser() не вызывается — он триггерит NotificationCenter с Long uid
        что ломает DialogsActivity и выбрасывает в «Все чаты».
        Хуки на getUser автоматически патчат остальных пользователей.
        """
        plugin_self = self

        def bg_prepare():
            """Background: собрать данные аккаунтов и обновить кэш."""
            try:
                active_accs = plugin_self._get_active_accounts_data()
                patches = []  # list of (acc_idx, uid, nc, nbg, prc, pbg, em_id, prem)
                any_changed = False

                for acc_info in active_accs:
                    acc_idx = acc_info.get("acc_idx", 0)
                    my_uid = acc_info.get("user_id", 0)
                    if my_uid <= 0:
                        continue
                    slot_p = plugin_self._get_profile_dict_for_slot(acc_idx, my_uid)
                    with plugin_self._sync_lock:
                        plugin_self._profiles_cache[my_uid] = slot_p
                        plugin_self._cache_dirty = True

                    nc  = _safe_int(slot_p.get("name_color", 0))
                    nbg = _safe_int(slot_p.get("name_bg_emoji_id", 0))
                    prc = _safe_int(slot_p.get("profile_color", 0))
                    pbg = _safe_int(slot_p.get("profile_bg_emoji_id", 0))
                    em_id = _safe_int(slot_p.get("emoji_status_id", 0))
                    prem  = bool(slot_p.get("premium", True))
                    patch_tuple = (acc_idx, my_uid, nc, nbg, prc, pbg, em_id, prem)
                    patches.append(patch_tuple)

                    # Баг 3: проверяем, изменились ли данные собственного профиля
                    with plugin_self._sync_lock:
                        cached_tuple = plugin_self._own_apply_cache.get(my_uid)
                        if cached_tuple != patch_tuple:
                            any_changed = True
                            plugin_self._own_apply_cache[my_uid] = patch_tuple

                # Обновляем кэш UID собственных аккаунтов
                plugin_self._own_uids_cache = {acc["user_id"] for acc in active_accs if acc.get("user_id", 0) > 0}
                plugin_self._update_snapshot_partial({p[1] for p in patches})

                def ui_apply(patches=patches, any_changed=any_changed):
                    try:
                        plugin_self._refresh_loaded_telegram_objects()
                        if any_changed:
                            plugin_self._sync_local_ayuconfig()
                    except Exception as e:
                        log(f"SyncProfile: _apply_all ui_apply error: {e}")

                run_on_ui_thread(ui_apply)
            except Exception as e:
                log(f"SyncProfile: _apply_all bg_prepare error: {e}")

        threading.Thread(target=bg_prepare, daemon=True).start()

    def push_specific_account(self, acc_idx: int, show_ui_bulletin: bool = True):
        uid = 0
        name = f"Аккаунт {acc_idx + 1}"
        try:
            from org.telegram.messenger import UserConfig
            u_c = UserConfig.getInstance(acc_idx)
            if u_c:
                uid = int(u_c.getClientUserId() or 0)
                cu = u_c.getCurrentUser()
                if cu:
                    name = str(getattr(cu, "first_name", "") or name)
        except Exception:
            pass

        if uid == 0:
            if show_ui_bulletin:
                bulletins.show_error(f"Не удалось определить Telegram ID для аккаунта {acc_idx + 1}")
            return

        # Инвалидируем кэш чтобы ui_apply применился после публикации
        with self._sync_lock:
            self._own_apply_cache.pop(uid, None)
        payload = self._get_profile_dict_for_slot(acc_idx, uid)
        def worker():
            try:
                status, data, err = self._api_request(
                    "POST",
                    "api/profile",
                    payload=payload,
                    timeout=6.0,
                    retries=2,
                    backoff_factor=0.5,
                )
                if status == 200:
                    with self._sync_lock:
                        self._profiles_cache[uid] = payload
                        self._cache_dirty = True
                    self._update_snapshot()
                    self._save_local_profiles_cache()
                    self._apply_all_to_all_accounts()
                    if show_ui_bulletin:
                        bulletins.show_success(
                            f"🚀 Профиль {name} (ID: {uid}) опубликован!\nЦвет: #{payload['name_color']} | Обложка: #{payload['profile_color']}"
                        )
                    return

                if show_ui_bulletin:
                    if status == 403:
                        bulletins.show_error("Ошибка 403: Доступ запрещён.")
                    elif status == 401:
                        bulletins.show_error("Ошибка 401: Доступ к серверу синхронизации ограничен.")
                    elif status > 0:
                        bulletins.show_error(f"Ошибка сервера: {status}")
                    else:
                        bulletins.show_error(f"Сетевая ошибка: {err or 'Неизвестная ошибка'}")
            except Exception as e:
                logger.error(f"Ошибка отправки профиля: {e}")
                if show_ui_bulletin:
                    bulletins.show_error(f"Сетевая ошибка: {e}")

        threading.Thread(target=worker, daemon=True).start()

    def push_all_accounts(self, show_ui_bulletin: bool = True):
        active_accs = self._get_active_accounts_data()
        if not active_accs:
            if show_ui_bulletin:
                bulletins.show_error("Нет активных аккаунтов для отправки.")
            return

        # Инвалидируем кэш чтобы ui_apply применился после публикации
        with self._sync_lock:
            for acc in active_accs:
                self._own_apply_cache.pop(acc.get("user_id", 0), None)

        def worker():
            success_count = 0
            errors = []

            def _push_single_acc(acc_info):
                acc_idx = acc_info["acc_idx"]
                uid = acc_info["user_id"]
                name = acc_info["name"]
                payload = self._get_profile_dict_for_slot(acc_idx, uid)
                try:
                    status, data, err = self._api_request(
                        "POST",
                        "api/profile",
                        payload=payload,
                        timeout=5.0,
                        retries=1,
                        backoff_factor=0.5,
                    )
                    return acc_info, status, data, err, payload, None
                except Exception as e:
                    return acc_info, 0, None, None, payload, e

            from concurrent.futures import ThreadPoolExecutor
            with ThreadPoolExecutor(max_workers=min(len(active_accs), 4)) as executor:
                results = list(executor.map(_push_single_acc, active_accs))

            for acc_info, status, data, err, payload, exc in results:
                name = acc_info["name"]
                uid = acc_info["user_id"]
                if exc is not None:
                    errors.append(f"{name}: {str(exc)[:30]}")
                elif status == 200:
                    success_count += 1
                    with self._sync_lock:
                        self._profiles_cache[uid] = payload
                        self._cache_dirty = True
                else:
                    errors.append(f"{name}: {err or f'HTTP {status}'}")

            if success_count > 0:
                self._update_snapshot()
                self._save_local_profiles_cache()
                self._apply_all_to_all_accounts()

            if show_ui_bulletin:
                if success_count == len(active_accs):
                    bulletins.show_success(f"🎉 Все аккаунты ({success_count}) успешно опубликованы на сервере!")
                elif success_count > 0:
                    bulletins.show_info(f"Опубликовано {success_count}/{len(active_accs)}. Ошибки:\n" + "\n".join(errors))
                else:
                    bulletins.show_error(f"Не удалось опубликовать ни один аккаунт:\n" + "\n".join(errors))

        threading.Thread(target=worker, daemon=True).start()

    def _save_local_profiles_cache(self, force: bool = False):
        if not force and not self._cache_dirty:
            return
        try:
            with self._sync_lock:
                cache_copy = {
                    "profiles": dict(self._profiles_cache),
                    "chats": dict(self._chats_cache),
                }
                self._cache_dirty = False

            if HAS_ZWYLIB and self._json_cache_file is not None:
                self._json_cache_file.content = cache_copy
                self._json_cache_file.write()
                return

            try:
                import os
                cache_path = "sync_profiles_cache.json"
                tmp_path = "sync_profiles_cache.json.tmp"
                with open(tmp_path, "w", encoding="utf-8") as f:
                    json.dump(cache_copy, f, ensure_ascii=False)
                if os.path.exists(cache_path):
                    os.replace(tmp_path, cache_path)
                else:
                    os.rename(tmp_path, cache_path)
                return
            except Exception:
                pass

            cache_str = json.dumps(cache_copy, ensure_ascii=False)
            self.set_setting("_local_profiles_json", cache_str, reload_settings=False)
        except Exception as e:
            logger.error(f"Save cache error: {e}")

    def _load_local_profiles_cache(self):
        try:
            data = None
            if HAS_ZWYLIB and self._json_cache_file is not None:
                try:
                    self._json_cache_file.read()
                    data = self._json_cache_file.content
                except Exception:
                    data = None

            if not isinstance(data, dict) or not data:
                import os
                cache_path = "sync_profiles_cache.json"
                if os.path.exists(cache_path):
                    try:
                        with open(cache_path, "r", encoding="utf-8") as f:
                            data = json.load(f)
                    except Exception:
                        data = None

            if not isinstance(data, dict) or not data:
                saved_str = self.get_setting("_local_profiles_json", "{}")
                if saved_str and saved_str != "{}":
                    try:
                        data = json.loads(saved_str)
                    except Exception:
                        data = None

            if isinstance(data, dict):
                with self._sync_lock:
                    if "profiles" in data or "chats" in data:
                        p_map = data.get("profiles", {})
                        if isinstance(p_map, dict):
                            for uid_str, p_data in p_map.items():
                                if str(uid_str).isdigit():
                                    self._profiles_cache[int(uid_str)] = p_data
                        c_map = data.get("chats", {})
                        if isinstance(c_map, dict):
                            for cid_str, c_data in c_map.items():
                                cid_norm = _normalize_chat_id(cid_str)
                                if cid_norm > 0:
                                    self._chats_cache[cid_norm] = c_data
                    else:
                        # Legacy flat dict
                        for uid_str, p_data in data.items():
                            if str(uid_str).isdigit():
                                self._profiles_cache[int(uid_str)] = p_data
                self._update_snapshot()
                run_on_ui_thread(self._refresh_loaded_telegram_objects)
        except Exception as e:
            logger.error(f"Load cache error: {e}")

    def _register_menu_items(self):
        # Кнопки в контекстном меню профиля (рефреш и инфо) удалены —
        # SDK не передаёт правильный user в on_click для этого типа меню.
        # Информация об использовании SyncProfile теперь показывается
        # автоматически через ProfileActivity.onResume хук.
        try:
            if not hasattr(self, "add_menu_item") or MenuItemType is None or MenuItemData is None:
                return

            msg_menu_type = None
            if hasattr(MenuItemType, "__members__") and isinstance(MenuItemType.__members__, dict):
                for name in ("MESSAGE_CONTEXT_MENU", "MESSAGE_ACTION_MENU", "MESSAGE", "CHAT_ACTION_MENU"):
                    if name in MenuItemType.__members__:
                        msg_menu_type = MenuItemType.__members__[name]
                        break
            if msg_menu_type is None:
                for name in ("MESSAGE_CONTEXT_MENU", "MESSAGE_ACTION_MENU", "MESSAGE", "CHAT_ACTION_MENU"):
                    try:
                        val = getattr(MenuItemType, name, None)
                        if val is not None:
                            msg_menu_type = val
                            break
                    except Exception:
                        pass

            if msg_menu_type is not None:
                def _make_msg_item(item_id: str, text: str, icon: str, on_click: Any, priority: int = 50):
                    for c in (
                        lambda: MenuItemData(menu_type=msg_menu_type, text=text, on_click=on_click, icon=icon, priority=priority),
                        lambda: MenuItemData(id=item_id, type=msg_menu_type, text=text, icon=icon, on_click=on_click),
                        lambda: MenuItemData(menu_type=msg_menu_type, text=text, on_click=on_click, icon=icon),
                        lambda: MenuItemData(type=msg_menu_type, text=text, icon=icon, on_click=on_click),
                    ):
                        try:
                            return c()
                        except Exception:
                            continue
                    return None

                item3 = _make_msg_item("copy_emoji_id", "🆔 Скопировать Emoji Document ID", "msg_emoji", self._on_copy_emoji_id_click, 50)
                if item3:
                    try:
                        self.add_menu_item(item3)
                    except Exception:
                        pass
        except Exception as e:
            logger.warning(f"_register_menu_items error: {e}")

    def _extract_user_from_menu_args(self, *args, **kwargs):
        user = None
        user_id = 0
        if "user" in kwargs:
            user = kwargs["user"]
        elif "user_id" in kwargs:
            try: user_id = int(kwargs["user_id"])
            except Exception: pass
        elif "userId" in kwargs:
            try: user_id = int(kwargs["userId"])
            except Exception: pass

        if not user and not user_id and args:
            for arg in args:
                if isinstance(arg, dict):
                    user = arg.get("user")
                    if not user and "user_id" in arg:
                        try: user_id = int(arg["user_id"])
                        except Exception: pass
                    if not user and "userId" in arg:
                        try: user_id = int(arg["userId"])
                        except Exception: pass
                    if user or user_id:
                        break
                elif isinstance(arg, int) and arg > 0:
                    user_id = arg
                    break
                elif hasattr(arg, "id") and not hasattr(arg, "getParentActivity") and not hasattr(arg, "findViewById"):
                    user = arg
                    break
                elif hasattr(arg, "getUser"):
                    try:
                        u = arg.getUser()
                        if u:
                            user = u
                            break
                    except Exception:
                        pass

        if not user and not user_id:
            try:
                from org.telegram.ui import LaunchActivity
                frag = None
                if hasattr(LaunchActivity, "getLastFragment"):
                    frag = LaunchActivity.getLastFragment()
                if frag and hasattr(frag, "getUser"):
                    try: user = frag.getUser()
                    except Exception: pass
                if not user and frag and hasattr(frag, "getCurrentUser"):
                    try: user = frag.getCurrentUser()
                    except Exception: pass
                if not user and frag and hasattr(frag, "user_id"):
                    try: user_id = int(getattr(frag, "user_id", 0) or 0)
                    except Exception: pass
                if not user and frag and hasattr(frag, "userId"):
                    try: user_id = int(getattr(frag, "userId", 0) or 0)
                    except Exception: pass
            except Exception:
                pass

        if user and not user_id:
            user_id = int(getattr(user, "id", 0) or 0)
        return user, user_id

    def _resolve_message_object(self, obj: Any, depth: int = 0) -> Any:
        if obj is None or depth > 6:
            return None

        cls_name = type(obj).__name__

        # 1. ChatMessageCell or any object with getMessageObject() (must resolve before "Message" substring check)
        if hasattr(obj, "getMessageObject"):
            try:
                mo = obj.getMessageObject()
                if mo is not None:
                    res = self._resolve_message_object(mo, depth + 1)
                    if res is not None:
                        return res
            except Exception:
                pass

        # 2. ChatMessageCell or view with currentMessageObject or messageObject
        if hasattr(obj, "currentMessageObject"):
            val = getattr(obj, "currentMessageObject", None)
            if val is not None:
                res = self._resolve_message_object(val, depth + 1)
                if res is not None:
                    return res
        if hasattr(obj, "messageObject"):
            val = getattr(obj, "messageObject", None)
            if val is not None:
                res = self._resolve_message_object(val, depth + 1)
                if res is not None:
                    return res

        # 3. Direct MessageObject (has messageOwner or type MessageObject)
        if "MessageObject" in cls_name or hasattr(obj, "messageOwner"):
            return obj

        # 4. TLRPC.Message / TL_message (has id, and entities or media or message)
        if (
            cls_name in ("Message", "TL_message", "TL_messageService")
            or "TLRPC$TL_message" in str(type(obj))
            or cls_name.startswith("TL_message")
            or (hasattr(obj, "id") and (hasattr(obj, "entities") or hasattr(obj, "media") or hasattr(obj, "message") or hasattr(obj, "flags") or hasattr(obj, "peer_id")))
        ):
            return obj

        # Fragment / ChatActivity with selectedMessageObject, selectedObject, getSelectedObject()
        for attr in ("selectedMessageObject", "selectedObject", "contextMenuMessageObject", "selectedMessage"):
            if hasattr(obj, attr):
                val = getattr(obj, attr, None)
                if val is not None:
                    res = self._resolve_message_object(val, depth + 1)
                    if res is not None:
                        return res
        if hasattr(obj, "getSelectedObject"):
            try:
                val = obj.getSelectedObject()
                if val is not None:
                    res = self._resolve_message_object(val, depth + 1)
                    if res is not None:
                        return res
            except Exception:
                pass
        if hasattr(obj, "contextMenuCell"):
            val = getattr(obj, "contextMenuCell", None)
            if val is not None:
                res = self._resolve_message_object(val, depth + 1)
                if res is not None:
                    return res

        # ChatActivity selectedObjects map / collection / LongSparseArray
        if hasattr(obj, "selectedObjects"):
            so = getattr(obj, "selectedObjects", None)
            if so is not None:
                if isinstance(so, dict):
                    for v in so.values():
                        res = self._resolve_message_object(v, depth + 1)
                        if res is not None:
                            return res
                elif hasattr(so, "size") and hasattr(so, "valueAt"):
                    try:
                        for i in range(so.size()):
                            res = self._resolve_message_object(so.valueAt(i), depth + 1)
                            if res is not None:
                                return res
                    except Exception:
                        pass
                elif hasattr(so, "values"):
                    try:
                        vals = so.values()
                        arr = vals.toArray() if hasattr(vals, "toArray") else list(vals)
                        for v in arr:
                            res = self._resolve_message_object(v, depth + 1)
                            if res is not None:
                                return res
                    except Exception:
                        pass

        # ChatActivity messages array / list
        if hasattr(obj, "messages"):
            msgs = getattr(obj, "messages", None)
            if msgs is not None:
                m_cnt = msgs.size() if hasattr(msgs, "size") else len(msgs) if hasattr(msgs, "__len__") else 0
                if m_cnt > 0:
                    first_m = msgs.get(0) if hasattr(msgs, "get") else msgs[0]
                    res = self._resolve_message_object(first_m, depth + 1)
                    if res is not None:
                        return res

        # Dict unwrapping
        if isinstance(obj, dict):
            for k in (
                "context", "message", "messageObject", "message_object", "msg", "cell",
                "chat_message_cell", "view", "fragment", "chatActivity", "chat_activity",
                "activity", "selectedObject", "selectedMessage", "selectedMessageObject",
                "obj", "object", "item", "data", "target"
            ):
                if k in obj and obj[k] is not None:
                    res = self._resolve_message_object(obj[k], depth + 1)
                    if res is not None:
                        return res
            for v in obj.values():
                res = self._resolve_message_object(v, depth + 1)
                if res is not None:
                    return res

        # List / tuple / TL_vector unwrapping
        if isinstance(obj, (list, tuple)):
            for item in obj:
                res = self._resolve_message_object(item, depth + 1)
                if res is not None:
                    return res

        # Android View: getTag()
        if hasattr(obj, "getTag"):
            try:
                tag = obj.getTag()
                if tag is not None and tag != obj:
                    res = self._resolve_message_object(tag, depth + 1)
                    if res is not None:
                        return res
            except Exception:
                pass

        # Android View: getContext() -> LaunchActivity / ChatActivity
        if hasattr(obj, "getContext"):
            try:
                ctx = obj.getContext()
                if ctx is not None:
                    if hasattr(ctx, "getActionBarLayout"):
                        abl = ctx.getActionBarLayout()
                        if abl and hasattr(abl, "getLastFragment"):
                            res = self._resolve_message_object(abl.getLastFragment(), depth + 1)
                            if res is not None:
                                return res
                    res = self._resolve_message_object(ctx, depth + 1)
                    if res is not None:
                        return res
            except Exception:
                pass

        return None

    def _extract_message_from_menu_args(self, *args, **kwargs) -> Any:
        # 1. Check keyword arguments
        if "context" in kwargs and kwargs["context"] is not None:
            mo = self._resolve_message_object(kwargs["context"])
            if mo is not None:
                return mo

        for k in (
            "message", "messageObject", "message_object", "msg", "cell", "view",
            "fragment", "dialog", "chatActivity", "chat_activity", "activity", "selectedObject",
            "selected_object", "selectedMessage", "selectedMessageObject", "obj", "object", "item", "data", "target"
        ):
            if k in kwargs and kwargs[k] is not None:
                mo = self._resolve_message_object(kwargs[k])
                if mo is not None:
                    return mo

        # 2. Check positional arguments
        if args:
            for arg in args:
                mo = self._resolve_message_object(arg)
                if mo is not None:
                    return mo

        # 3. Check tracked last selected message from cell/activity hooks
        if hasattr(self, "_last_selected_message") and self._last_selected_message is not None:
            mo = self._resolve_message_object(self._last_selected_message)
            if mo is not None:
                return mo

        # 4. Check active ChatActivity / LaunchActivity
        try:
            from org.telegram.ui import LaunchActivity
            act = getattr(LaunchActivity, "instance", None)
            if act is not None:
                if hasattr(act, "getActionBarLayout"):
                    abl = act.getActionBarLayout()
                    if abl and hasattr(abl, "getLastFragment"):
                        mo = self._resolve_message_object(abl.getLastFragment())
                        if mo is not None:
                            return mo
                if hasattr(act, "visibleFragments"):
                    vf = act.visibleFragments
                    if vf:
                        cnt = vf.size() if hasattr(vf, "size") else len(vf)
                        for i in range(cnt - 1, -1, -1):
                            frag = vf.get(i) if hasattr(vf, "get") else vf[i]
                            mo = self._resolve_message_object(frag)
                            if mo is not None:
                                return mo
                mo = self._resolve_message_object(act)
                if mo is not None:
                    return mo
        except Exception:
            pass

        try:
            from org.telegram.ui import LaunchActivity
            if hasattr(LaunchActivity, "visibleFragments"):
                vf = LaunchActivity.visibleFragments
                if vf:
                    cnt = vf.size() if hasattr(vf, "size") else len(vf)
                    for i in range(cnt - 1, -1, -1):
                        frag = vf.get(i) if hasattr(vf, "get") else vf[i]
                        mo = self._resolve_message_object(frag)
                        if mo is not None:
                            return mo
        except Exception:
            pass

        return None

    def _extract_custom_emoji_ids(self, message: Any) -> List[int]:
        found_ids: List[int] = []
        if message is None:
            return found_ids

        # If message is ChatMessageCell or container, unwrap to MessageObject
        if hasattr(message, "getMessageObject"):
            try:
                inner = message.getMessageObject()
                if inner:
                    message = inner
            except Exception:
                pass
        elif hasattr(message, "currentMessageObject"):
            inner = getattr(message, "currentMessageObject", None)
            if inner:
                message = inner
        elif hasattr(message, "messageObject"):
            inner = getattr(message, "messageObject", None)
            if inner:
                message = inner

        def _add_id(val: Any):
            if val is None:
                return
            safe = _safe_int(val, 0)
            if safe > 0 and safe not in found_ids:
                found_ids.append(safe)

        # 1. MessageOwner & entities list
        msg_owner = getattr(message, "messageOwner", None) or message

        def _scan_entities(entities: Any):
            if not entities:
                return
            cnt = entities.size() if hasattr(entities, "size") else len(entities)
            for i in range(cnt):
                entity = entities.get(i) if hasattr(entities, "get") else entities[i]
                if entity is None:
                    continue
                # TL_messageEntityCustomEmoji document_id / documentId
                doc_id = getattr(entity, "document_id", None) or getattr(entity, "documentId", None)
                if doc_id is not None:
                    _add_id(doc_id)
                elif hasattr(entity, "document") and entity.document:
                    _add_id(getattr(entity.document, "id", None))

                # TL_messageEntityTextUrl (tg://emoji?id=... or t.me/emoji/...)
                url = getattr(entity, "url", None)
                if url:
                    url_str = str(url)
                    if "emoji" in url_str:
                        extracted = _extract_emoji_doc_id_from_url(url_str)
                        if extracted:
                            _add_id(extracted)

        if hasattr(msg_owner, "entities"):
            _scan_entities(msg_owner.entities)
        if hasattr(message, "entities") and message != msg_owner:
            _scan_entities(message.entities)
        if hasattr(message, "captionEntities"):
            _scan_entities(message.captionEntities)
        if hasattr(msg_owner, "captionEntities"):
            _scan_entities(msg_owner.captionEntities)

        # 2. Spannable text & CharSequence fields (messageText, caption, text, message)
        for text_field in ("messageText", "caption", "text", "message"):
            text_obj = getattr(message, text_field, None) or getattr(msg_owner, text_field, None)
            if text_obj is not None:
                if hasattr(text_obj, "getSpans"):
                    try:
                        t_len = text_obj.length() if hasattr(text_obj, "length") else len(text_obj)
                        spans = None
                        try:
                            spans = text_obj.getSpans(0, t_len, None)
                        except Exception:
                            try:
                                from java.lang import Object as JObject
                                spans = text_obj.getSpans(0, t_len, JObject)
                            except Exception:
                                pass
                        if spans is not None:
                            s_cnt = spans.size() if hasattr(spans, "size") else len(spans)
                            for i in range(s_cnt):
                                span = spans.get(i) if hasattr(spans, "get") else spans[i]
                                if span is None:
                                    continue
                                d_id = (
                                    getattr(span, "documentId", None)
                                    or getattr(span, "document_id", None)
                                    or getattr(span, "docId", None)
                                )
                                if d_id is None and hasattr(span, "getDocumentId"):
                                    try: d_id = span.getDocumentId()
                                    except Exception: pass
                                if d_id is None and hasattr(span, "document"):
                                    doc_obj = getattr(span, "document", None)
                                    if doc_obj:
                                        d_id = getattr(doc_obj, "id", None)
                                if d_id is None and hasattr(span, "getURL"):
                                    try:
                                        u_val = str(span.getURL())
                                        if "emoji" in u_val:
                                            d_id = _extract_emoji_doc_id_from_url(u_val)
                                    except Exception:
                                        pass
                                if d_id is not None:
                                    _add_id(d_id)
                    except Exception:
                        pass

                # Regex search in string representation (tg://emoji?id=..., document_id=..., t.me/emoji/...)
                try:
                    import re
                    s_text = str(text_obj)
                    for m in re.finditer(r'(?:emoji[_-]?id|document[_-]?id)[=":\s]+(\d{10,25})', s_text, re.IGNORECASE):
                        _add_id(m.group(1))
                    for m in re.finditer(r'tg://emoji\?id=(\d{10,25})', s_text, re.IGNORECASE):
                        _add_id(m.group(1))
                    for m in re.finditer(r't\.me/emoji/(\d{10,25})', s_text, re.IGNORECASE):
                        _add_id(m.group(1))
                except Exception:
                    pass

        # 3. Media / Sticker / Custom Emoji Document (media.document)
        media_obj = getattr(msg_owner, "media", None) or getattr(message, "media", None)
        if media_obj is not None:
            # TL_messageMediaDocument
            doc = getattr(media_obj, "document", None)
            if doc is not None:
                _add_id(getattr(doc, "id", None))
            # alt_document (for stickers / animated emoji)
            alt_doc = getattr(media_obj, "alt_document", None)
            if alt_doc is not None:
                _add_id(getattr(alt_doc, "id", None))
            # TL_messageMediaPaidMedia
            extended_media = getattr(media_obj, "extended_media", None)
            if extended_media:
                em_cnt = extended_media.size() if hasattr(extended_media, "size") else len(extended_media)
                for i in range(em_cnt):
                    em = extended_media.get(i) if hasattr(extended_media, "get") else extended_media[i]
                    em_doc = getattr(em, "document", None)
                    if em_doc:
                        _add_id(getattr(em_doc, "id", None))

        for doc_method in ("getDocument", "getStickerDocument", "getCustomEmojiDocument"):
            if hasattr(message, doc_method):
                try:
                    doc = getattr(message, doc_method)()
                    if doc and hasattr(doc, "id"):
                        _add_id(doc.id)
                except Exception:
                    pass

        # 4. Reactions
        reactions = getattr(msg_owner, "reactions", None) or getattr(message, "reactions", None)
        if reactions and hasattr(reactions, "results"):
            results = reactions.results
            r_cnt = results.size() if hasattr(results, "size") else len(results)
            for i in range(r_cnt):
                res = results.get(i) if hasattr(results, "get") else results[i]
                reaction = getattr(res, "reaction", None)
                if reaction:
                    _add_id(getattr(reaction, "document_id", None) or getattr(reaction, "documentId", None))

        # 5. Check replyMessageObject if nothing found yet
        if not found_ids and hasattr(message, "replyMessageObject"):
            reply_mo = getattr(message, "replyMessageObject", None)
            if reply_mo and reply_mo != message:
                reply_ids = self._extract_custom_emoji_ids(reply_mo)
                for rid in reply_ids:
                    _add_id(rid)

        # 6. Fallback: Sender user emoji status
        if not found_ids:
            try:
                from_user = getattr(message, "fromUser", None) or getattr(msg_owner, "from_id", None)
                if from_user and hasattr(from_user, "emoji_status") and from_user.emoji_status:
                    _add_id(getattr(from_user.emoji_status, "document_id", None))
            except Exception:
                pass

        return found_ids

    def _on_refresh_single_profile_click(self, *args, **kwargs):
        user, user_id = self._extract_user_from_menu_args(*args, **kwargs)
        if user_id <= 0:
            bulletins.show_error("Не удалось определить ID пользователя.")
            return

        def worker():
            try:
                status, data, err = self._api_request(
                    "GET",
                    f"api/profile/{user_id}",
                    timeout=6.0,
                    retries=1,
                    backoff_factor=0.5,
                )
                if status == 200 and isinstance(data, dict):
                    prof = data.get("profile") or data
                    if prof and "user_id" in prof:
                        with self._sync_lock:
                            self._profiles_cache[user_id] = prof
                            self._cache_dirty = True
                        self._update_snapshot()
                        self._save_local_profiles_cache()
                        run_on_ui_thread(self._apply_all_to_all_accounts)
                        bulletins.show_success(
                            f"✅ Профиль ID {user_id} обновлен!\nЦвет: #{prof.get('name_color')} | Обложка: #{prof.get('profile_color')}"
                        )
                        return

                bulletins.show_info(f"Профиль ID {user_id} не найден на сервере.")
            except Exception as e:
                logger.error(f"Ошибка обновления профиля {user_id}: {e}")
                bulletins.show_error(f"Ошибка загрузки профиля: {e}")

        threading.Thread(target=worker, daemon=True).start()

    def _on_profile_menu_click(self, *args, **kwargs):
        user, user_id = self._extract_user_from_menu_args(*args, **kwargs)
        if user_id <= 0:
            bulletins.show_info("Не удалось получить объект пользователя.")
            return
        profile = None
        with self._sync_lock:
            profile = self._profiles_cache.get(user_id)

        if profile:
            info = (
                f"👤 ID: {user_id}\n"
                f"⭐ Premium: {'Да' if profile.get('premium') else 'Нет'}\n"
                f"🎨 Цвет имени/реплаев: #{profile.get('name_color', 0)} (узор: {profile.get('name_bg_emoji_id', 0)})\n"
                f"🖼️ Цвет обложки: #{profile.get('profile_color', 0)} (узор: {profile.get('profile_bg_emoji_id', 0)})\n"
                f"🆔 Эмодзи-статус ID: {profile.get('emoji_status_id', 'Нет')}"
            )
            bulletins.show_info(f"SyncProfile активен:\n{info}")
        else:
            bulletins.show_info(f"Пользователь {user_id} не найден в локальной базе.")

    def _on_copy_emoji_id_click(self, *args, **kwargs):
        message = self._extract_message_from_menu_args(*args, **kwargs)
        doc_ids = []
        if message:
            doc_ids = self._extract_custom_emoji_ids(message)

        if not doc_ids and hasattr(self, "_last_selected_message") and self._last_selected_message is not None:
            doc_ids = self._extract_custom_emoji_ids(self._last_selected_message)

        if not message and not doc_ids:
            bulletins.show_error("Сообщение не найдено.")
            return

        if doc_ids:
            found_id = str(doc_ids[0])
            if len(doc_ids) == 1:
                self._copy_text_to_clipboard(found_id, f"🆔 Emoji ID скопирован:\n{found_id}")
            else:
                all_ids_str = ", ".join(str(d) for d in doc_ids)
                self._copy_text_to_clipboard(
                    found_id,
                    f"🆔 Скопирован 1-й Emoji ID: {found_id}\n(Найдено {len(doc_ids)}: {all_ids_str})"
                )
        else:
            bulletins.show_info("В этом сообщении не найдено кастомных эмодзи.")

    def _copy_text_to_clipboard(self, text: str, success_msg: str = ""):
        if not text:
            return
        try:
            from org.telegram.messenger import AndroidUtilities
            AndroidUtilities.addToClipboard(text)
            if not success_msg:
                success_msg = f"Скопировано: {text}"
            bulletins.show_with_copy("Скопировано", text)
            return
        except Exception:
            pass

        try:
            from android.content import Context, ClipData
            from org.telegram.messenger import ApplicationLoader
            ctx = getattr(ApplicationLoader, "applicationContext", None)
            if ctx:
                cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
                clip = ClipData.newPlainText("text", text)
                cm.setPrimaryClip(clip)
                if not success_msg:
                    success_msg = f"Скопировано: {text}"
                bulletins.show_with_copy("Скопировано", text)
                return
        except Exception:
            pass

        bulletins.show_info(f"Скопировано: {text}")

    def create_settings(self) -> List[Any]:
        try:
            return self._create_settings_items()
        except Exception as e:
            logger.error(f"SyncProfile: create_settings error: {e}")
            return [
                Header(text="Синхронизация профилей SyncProfile"),
                Text(
                    text="🧹 Очистить локальный кэш",
                    subtext=f"Произошла ошибка при загрузке настроек ({e}). Нажмите для сброса кэша.",
                    icon="msg_delete",
                    red=True,
                    on_click=lambda view: self._clear_cache_action(view),
                ),
            ]

    def _create_settings_items(self) -> List[Any]:
        items = [
            Header(text="Синхронизация профилей SyncProfile"),
            Switch(
                key="enable_sync",
                text="Включить SyncProfile",
                default=True,
                subtext="Отображать кастомные профили и цвета других пользователей плагина",
                icon="msg_sync",
            ),
            Selector(
                key="auto_sync_interval",
                text="Интервал автообновления",
                default=1,
                items=AUTO_SYNC_INTERVALS,
                icon="msg_sync",
            ),
            Switch(
                key="show_syncprofile_badge_in_about",
                text="Бейдж в описании («О себе»)",
                default=True,
                subtext="Добавлять значок «⚡ Этот пользователь использует SyncProfile» в описание пользователя",
                icon="msg_info",
            ),
        ]

        if ALLOW_CUSTOM_SERVER_CONFIG:
            items.extend([
                Input(
                    key="server_url",
                    text="URL сервера",
                    default=DEFAULT_SERVER_URL,
                    subtext="Адрес сервера (https://sync.efn.mom)",
                    icon="msg_link",
                ),
                Input(
                    key="custom_cookie",
                    text="Секретный токен Cookie",
                    default=DEFAULT_SECRET_COOKIE,
                    subtext="Ключ авторизации для доступа к sync.efn.mom",
                    icon="msg_secret",
                ),
            ])

        items.extend([
            Divider(text="Общие действия"),
            Text(
                text="🔄 Синхронизировать с сервером",
                subtext="Получить свежие обновления профилей и каналов с сервера",
                icon="msg_sync",
                accent=True,
                on_click=lambda view: self.sync_delta_updates_from_server(show_bulletin=True),
            ),
            Text(
                text="🚀 Опубликовать все аккаунты",
                subtext="Отправить настройки и цвета всех активных аккаунтов на сервер в один клик",
                icon="msg_send",
                accent=True,
                on_click=lambda view: self.push_all_accounts(show_ui_bulletin=True),
            ),
            Text(
                text="🧹 Сбросить кэш и перекачать базу",
                subtext="Полная очистка локального кэша и принудительная загрузка всей базы с нуля",
                icon="msg_delete",
                red=True,
                on_click=lambda view: self._clear_cache_action(view),
            ),
        ])

        active_accs = self._get_active_accounts_data()

        for acc_info in active_accs:
            acc_idx = acc_info.get("acc_idx", 0)
            uid = acc_info.get("user_id", 0)
            name = acc_info.get("name", f"Аккаунт {acc_idx + 1}")
            extra = acc_info.get("extra", "")
            is_curr = acc_info.get("is_current", False)

            curr_tag = " [ТЕКУЩИЙ АКТИВНЫЙ]" if is_curr else ""
            section_title = f"👤 {name}{extra} (ID: {uid}){curr_tag}"

            default_name_c = 0
            default_prof_c = 0

            cur_prem = bool(self._get_slot_val(acc_idx, "premium", True))
            cur_name_c = int(self._get_slot_val(acc_idx, "name_color", default_name_c) or 0)
            cur_prof_c = int(self._get_slot_val(acc_idx, "profile_color", default_prof_c) or 0)

            if cur_name_c < 0 or cur_name_c >= len(NAME_AND_REPLY_COLORS):
                cur_name_c = default_name_c
            if cur_prof_c < 0 or cur_prof_c >= len(PROFILE_COLORS):
                cur_prof_c = default_prof_c

            cur_name_bg = self._get_slot_val(acc_idx, "name_bg_emoji_id", DEFAULT_NAME_BG_EMOJI) or ""
            cur_prof_bg = self._get_slot_val(acc_idx, "profile_bg_emoji_id", DEFAULT_PROFILE_BG_EMOJI) or ""
            cur_em_id = self._get_slot_val(acc_idx, "emoji_status_id", DEFAULT_EMOJI_STATUS_ID) or ""

            items.extend([
                Divider(text=section_title),
                Text(
                    text=f"🚀 Опубликовать профиль {name}",
                    subtext=f"Отправить цвета и узоры для ID {uid} на сервер",
                    icon="msg_send",
                    accent=True,
                    on_click=lambda view, a=acc_idx: self.push_specific_account(a, show_ui_bulletin=True),
                ),
                Switch(
                    key=f"slot_{acc_idx}_premium",
                    text=f"Telegram Premium [{name}]",
                    default=cur_prem,
                    subtext=f"Отображать Premium-статус и звездочку для {name}",
                    icon="msg_premium",
                    on_change=lambda val, a=acc_idx: (self._set_slot_val(a, "premium", val), self._apply_all_to_all_accounts()),
                ),
                Selector(
                    key=f"slot_{acc_idx}_name_color",
                    text=f"Цвет имени и реплаев [{name}]",
                    default=cur_name_c,
                    items=NAME_AND_REPLY_COLORS,
                    icon="msg_palette",
                    on_change=lambda idx, a=acc_idx: (self._set_slot_val(a, "name_color", idx), self._apply_all_to_all_accounts()),
                ),
                Input(
                    key=f"slot_{acc_idx}_name_bg_emoji_id",
                    text=f"Узор имени и реплаев [{name}]",
                    default=cur_name_bg,
                    subtext="Document ID эмодзи-узора (оставьте пустым, если не нужен)",
                    icon="msg_background",
                    on_change=lambda val, a=acc_idx: (self._set_slot_val(a, "name_bg_emoji_id", val), self._apply_all_to_all_accounts()),
                ),
                Selector(
                    key=f"slot_{acc_idx}_profile_color",
                    text=f"Цвет обложки [{name}]",
                    default=cur_prof_c,
                    items=PROFILE_COLORS,
                    icon="msg_theme",
                    on_change=lambda idx, a=acc_idx: (self._set_slot_val(a, "profile_color", idx), self._apply_all_to_all_accounts()),
                ),
                Input(
                    key=f"slot_{acc_idx}_profile_bg_emoji_id",
                    text=f"Узор обложки [{name}]",
                    default=cur_prof_bg,
                    subtext="ID эмодзи-узора (значки вокруг аватарки, оставьте пустым)",
                    icon="msg_background",
                    on_change=lambda val, a=acc_idx: (self._set_slot_val(a, "profile_bg_emoji_id", val), self._apply_all_to_all_accounts()),
                ),
                Input(
                    key=f"slot_{acc_idx}_emoji_status_id",
                    text=f"Эмодзи-статус [{name}]",
                    default=cur_em_id,
                    subtext="ID эмодзи-статуса рядом с именем (оставьте пустым, если не нужен)",
                    icon="msg_emoji",
                    on_change=lambda val, a=acc_idx: (self._set_slot_val(a, "emoji_status_id", val), self._apply_all_to_all_accounts()),
                ),
            ])

        return items

    def _clear_cache_action(self, view: Any = None):
        with self._sync_op_lock:
            self._sync_in_progress = False
        with self._sync_lock:
            self._profiles_cache.clear()
            self._chats_cache.clear()
            self._cache_dirty = False
            self._patch_cache.clear()
        self._video_checked_uids.clear()
        self._video_checked_chat_ids.clear()
        if self._json_cache_file:
            try:
                self._json_cache_file.wipe()
            except Exception:
                pass
        self.set_setting("_last_sync_timestamp", 0, reload_settings=False)
        self._update_snapshot()
        self._save_local_profiles_cache(force=True)

        # Обновляем кэш UID собственных аккаунтов (для исключения из перезаписи в AyuGram)
        active_accs = self._get_active_accounts_data()
        self._own_uids_cache = {acc["user_id"] for acc in active_accs if acc.get("user_id", 0) > 0}
        self._own_slots_cache = {acc["user_id"]: acc["acc_idx"] for acc in active_accs if acc.get("user_id", 0) > 0}
        self._update_snapshot()
        self._apply_all_to_all_accounts()
        bulletins.show_info("Локальный кэш очищен. Загрузка базы с сервера...")

        threading.Thread(
            target=self._sync_database,
            kwargs={"show_bulletin": True, "force_clean": True},
            daemon=True,
        ).start()

