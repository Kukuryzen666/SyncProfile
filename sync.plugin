                class MsgObjGetPeerColorHook(MethodHook):
                    def after_hooked_method(self, param):
                        try:
                            msg_obj = getattr(param, "thisObject", None)
                            if msg_obj:
                                uid = 0
                                peer = getattr(msg_obj, "getFromPeer", lambda: None)()
