def _safe_int(val: Any, default: int = 0) -> int:
    if val is None:
        return default
    if isinstance(val, int):
        return val
    try:
        s = str(val).strip()
        if not s:
            return default
        return int(s)
    except Exception:
        return default

def _is_user(obj: Any) -> bool:
    if obj is None:
        return False
    if hasattr(obj, "first_name") or hasattr(obj, "phone") or hasattr(obj, "last_name"):
        return True
    cls_name = getattr(obj, "__class__", None)
    if cls_name and "User" in str(cls_name):
        return True
    return False

def _is_chat(obj: Any) -> bool:
    if obj is None:
        return False
    if hasattr(obj, "title") or hasattr(obj, "broadcast") or hasattr(obj, "megagroup") or hasattr(obj, "participants_count"):
        return True
    cls_name = getattr(obj, "__class__", None)
    if cls_name and ("Chat" in str(cls_name) or "Channel" in str(cls_name)):
        return True
    return False

def _normalize_chat_id(cid: Any) -> int:
    raw = _safe_int(cid, 0)
    if raw == 0:
        return 0
    s = str(raw)
    if s.startswith("-100") and len(s) > 4:
        try:
            return int(s[4:])
        except Exception:
            return abs(raw)
    return abs(raw)

def _get_class_methods(cls_obj: Any) -> List[Any]:
    if cls_obj is None:
        return []
    target = cls_obj
    if hasattr(target, "getClass"):
        try:
            target = target.getClass()
        except Exception:
            pass
    if hasattr(target, "getDeclaredMethods"):
        try:
            return list(target.getDeclaredMethods())
        except Exception:
            pass
    if hasattr(target, "getMethods"):
        try:
            return list(target.getMethods())
        except Exception:
            pass
    return []

def _build_peer_color(color_id: Any, bg_emoji_id: Any = None):
    if color_id is None:
        return None
    c = _safe_int(color_id, -1)
    if c < 0:
        return None
    bg = _safe_int(bg_emoji_id, 0)
    try:
        global TLRPC
        if TLRPC is None:
            from org.telegram.tgnet import TLRPC as _TLRPC
            TLRPC = _TLRPC
        pc = TLRPC.TL_peerColor()
        pc.color = c
        if bg != 0:
            pc.background_emoji_id = bg
            pc.flags = 3
        else:
            pc.background_emoji_id = 0
            pc.flags = 1
        return pc
    except Exception:
        return None

class Plugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._profiles_cache: Dict[int, Dict[str, Any]] = {}
        self._chats_cache: Dict[int, Dict[str, Any]] = {}
        self._sync_lock = threading.Lock()
        # Lock-free snapshot for hot-path reads from UI/getter threads
        self._profiles_snapshot: Dict[int, Dict[str, Any]] = {}
        self._chats_snapshot: Dict[int, Dict[str, Any]] = {}
        self._cache_dirty = False
        self._is_running = True
        self._xposed_unhooks: List[Any] = []
        self._json_cache_file = None
        self._last_selected_message: Optional[Any] = None

        if HAS_ZWYLIB:
            try:
                self._json_cache_file = JsonCacheFile("sync_profiles_cache.json", default={}, compress=True)
            except Exception as e:
                logger.error(f"Failed to init JsonCacheFile: {e}")

    def on_plugin_load(self):
        logger.info(f"SyncProfile v{__version__}: Загрузка (ZwyLib: {'Включен' if HAS_ZWYLIB else 'Не установлен'})...")
        self._is_running = True
        self._load_local_profiles_cache()
        self._auto_import_from_official_tg_premium()
        self._ensure_local_premium()

        # Seed local profile cache with own active accounts
        active_accs = self._get_active_accounts_data()
        with self._sync_lock:
            for acc_info in active_accs:
                acc_idx = acc_info.get("acc_idx", 0)
                my_uid = acc_info.get("user_id", 0)
                if my_uid > 0:
                    self._profiles_cache[my_uid] = self._get_profile_dict_for_slot(acc_idx, my_uid)
        self._update_snapshot()

        self._register_menu_items()
        self._register_xposed_hooks()

        if HAS_ZWYLIB:
            async_manager.run_task(self._async_initial_background_sync())
            async_manager.run_task(self._async_keep_alive_sync_loop())
        else:
            threading.Thread(target=self._initial_background_sync, daemon=True).start()
            threading.Thread(target=self._keep_alive_sync_loop, daemon=True).start()

        logger.info(f"SyncProfile v{__version__}: Успешно загружен!")

    def on_plugin_unload(self):
        self._is_running = False
        if HAS_ZWYLIB:
            try:
                async_manager.cancel_all_for(__id__)
            except Exception:
                pass

        self._unregister_xposed_hooks()
        self._save_local_profiles_cache(force=True)
        logger.info(f"SyncProfile v{__version__}: Выгружен.")

    def _ensure_local_premium(self):
        """Silently enables AyuGram localPremium so the client correctly sends
        TL_messageEntityCustomEmoji even through scheduled messages (отложка)."""
        try:
            from com.radolyn.ayugram import AyuConfig
            if hasattr(AyuConfig, "localPremium") and not AyuConfig.localPremium:
                AyuConfig.localPremium = True
                if hasattr(AyuConfig, "saveConfig"):
                    AyuConfig.saveConfig()
                elif hasattr(AyuConfig, "save"):
                    AyuConfig.save()
        except Exception:
            pass

    def _auto_import_from_official_tg_premium(self):
        imported_any = False
        try:
            from org.telegram.messenger import UserConfig
            max_accs = getattr(UserConfig, "MAX_ACCOUNT_COUNT", 4)
            for acc in range(max_accs):
                try:
                    u_cfg = UserConfig.getInstance(acc)
                    if not u_cfg or not u_cfg.isClientActivated():
                        continue

                    curr_user = u_cfg.getCurrentUser()
                    if not curr_user:
                        continue

                    is_real_premium = bool(
                        getattr(curr_user, "premium", False)
                        or ((getattr(curr_user, "flags", 0) or 0) & 0x10000000) != 0
                    )
                    has_official_color = hasattr(curr_user, "color") and curr_user.color is not None
                    has_official_profile_color = hasattr(curr_user, "profile_color") and curr_user.profile_color is not None
                    has_official_status = hasattr(curr_user, "emoji_status") and curr_user.emoji_status is not None

                    if is_real_premium or has_official_color or has_official_profile_color or has_official_status:
                        if not self.get_setting(f"slot_{acc}_configured", False):
                            self._set_slot_val(acc, "premium", True)
                            if has_official_color:
                                nc = int(getattr(curr_user.color, "color", 2) or 0)
                                if nc >= 0:
                                    self._set_slot_val(acc, "name_color", nc)
                                bg_em = getattr(curr_user.color, "background_emoji_id", 0)
                                if bg_em != 0:
                                    self._set_slot_val(acc, "name_bg_emoji_id", str(bg_em))

                            if has_official_profile_color:
                                prc = int(getattr(curr_user.profile_color, "color", 2) or 0)
                                if prc >= 0:
                                    self._set_slot_val(acc, "profile_color", prc)
                                p_bg_em = getattr(curr_user.profile_color, "background_emoji_id", 0)
                                if p_bg_em != 0:
                                    self._set_slot_val(acc, "profile_bg_emoji_id", str(p_bg_em))

                            if has_official_status:
                                doc_id = getattr(curr_user.emoji_status, "document_id", 0)
                                if doc_id != 0:
                                    self._set_slot_val(acc, "emoji_status_id", str(doc_id))

                            self.set_setting(f"slot_{acc}_configured", True, reload_settings=False)
                            imported_any = True
                            log(f"SyncProfile: Автоматически импортирован официальный TG Premium для аккаунта {acc + 1}")
                except Exception as e:
                    log(f"SyncProfile: Ошибка автоимпорта TG Premium для аккаунта {acc}: {e}")
        except Exception as e:
            log(f"SyncProfile: Ошибка автоимпорта: {e}")

        if imported_any:
            self._save_local_profiles_cache(force=True)

    def _get_my_active_uids(self) -> List[int]:
        uids = []
        try:
            from org.telegram.messenger import UserConfig
            for acc in range(4):
                try:
                    u_c = UserConfig.getInstance(acc)
                    if u_c and u_c.isClientActivated():
                        uid = int(u_c.getClientUserId() or 0)
                        if uid != 0 and uid not in uids:
                            uids.append(uid)
                except Exception:
                    pass
        except Exception:
            pass
        return uids

    def _get_active_accounts_data(self) -> List[Dict[str, Any]]:
        accounts = []
        try:
            from org.telegram.messenger import UserConfig
            selected = getattr(UserConfig, "selectedAccount", 0)
            max_accs = getattr(UserConfig, "MAX_ACCOUNT_COUNT", 4)
            for acc in range(max_accs):
                try:
                    u_cfg = UserConfig.getInstance(acc)
                    if not u_cfg:
                        continue

                    is_active = bool(u_cfg.isClientActivated())
                    curr_user = u_cfg.getCurrentUser()
                    uid = int(u_cfg.getClientUserId() or (getattr(curr_user, "id", 0) if curr_user else 0))

                    if is_active and uid > 0 and curr_user is not None:
                        fn = str(getattr(curr_user, "first_name", "") or "")
                        ln = str(getattr(curr_user, "last_name", "") or "")
                        uname = str(getattr(curr_user, "username", "") or "")
                        phone = str(getattr(curr_user, "phone", "") or "")

                        name = " ".join([p for p in [fn, ln] if p]).strip() or f"Аккаунт {acc + 1}"
                        extra = f"@{uname}" if uname else phone
                        extra_str = f" ({extra})" if extra else ""

                        is_curr = (acc == selected)
                        accounts.append({
                            "acc_idx": acc,
                            "user_id": uid,
                            "name": name,
                            "extra": extra_str,
                            "is_current": is_curr,
                        })
                except Exception:
                    pass
        except Exception:
            pass

        if not accounts:
            try:
                from org.telegram.messenger import UserConfig
                curr_user = UserConfig.getInstance(UserConfig.selectedAccount).getCurrentUser()
                uid = int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId() or (getattr(curr_user, "id", 0) if curr_user else 0))
                if uid > 0:
                    fn = str(getattr(curr_user, "first_name", "") or "") if curr_user else ""
                    ln = str(getattr(curr_user, "last_name", "") or "") if curr_user else ""
                    uname = str(getattr(curr_user, "username", "") or "") if curr_user else ""
                    name = " ".join([p for p in [fn, ln] if p]).strip() or "Мой аккаунт"
                    extra = f" (@{uname})" if uname else ""
                    accounts.append({
                        "acc_idx": UserConfig.selectedAccount,
                        "user_id": uid,
                        "name": name,
                        "extra": extra,
                        "is_current": True,
                    })
            except Exception:
                pass

        accounts.sort(key=lambda x: x["acc_idx"])
        return accounts

    def _get_slot_val(self, acc_idx: int, key: str, default: Any) -> Any:
        slot_key = f"slot_{acc_idx}_{key}"
        val = self.get_setting(slot_key, None)
        if val is not None and str(val).strip() != "":
            return val

        if acc_idx == 0:
            legacy_val = self.get_setting(f"my_{key}", None)
            if legacy_val is not None and str(legacy_val).strip() != "":
                return legacy_val

        return default

    def _sync_local_ayuconfig(self, acc_idx: int):
        try:
            from com.radolyn.ayugram import AyuConfig
            from org.telegram.messenger import UserConfig
            curr_acc = getattr(UserConfig, "selectedAccount", 0)
            if acc_idx == curr_acc:
                u_cfg = UserConfig.getInstance(acc_idx)
                uid = int(u_cfg.getClientUserId() or 0) if u_cfg else 0
                sel_p = self._get_profile_dict_for_slot(acc_idx, uid)
                if hasattr(AyuConfig, "nameColor"):
                    AyuConfig.nameColor = _safe_int(sel_p.get("name_color", 0))
                if hasattr(AyuConfig, "nameCustomEmojiId"):
                    AyuConfig.nameCustomEmojiId = _safe_int(sel_p.get("name_bg_emoji_id", 0))
                if hasattr(AyuConfig, "profileColor"):
                    AyuConfig.profileColor = _safe_int(sel_p.get("profile_color", 0))
                if hasattr(AyuConfig, "profileCustomEmojiId"):
                    AyuConfig.profileCustomEmojiId = _safe_int(sel_p.get("profile_bg_emoji_id", 0))
                if hasattr(AyuConfig, "statusEmojiId"):
                    AyuConfig.statusEmojiId = _safe_int(sel_p.get("emoji_status_id", 0))
                if hasattr(AyuConfig, "saveConfig"):
                    AyuConfig.saveConfig()
                elif hasattr(AyuConfig, "save"):
                    AyuConfig.save()
        except Exception:
            pass

    def _set_slot_val(self, acc_idx: int, key: str, val: Any):
        slot_key = f"slot_{acc_idx}_{key}"
        self.set_setting(slot_key, val)
        self.set_setting(f"slot_{acc_idx}_configured", True, reload_settings=False)
        if acc_idx == 0:
            self.set_setting(f"my_{key}", val)
        self._sync_local_ayuconfig(acc_idx)

    def _get_profile_dict_for_slot(self, acc_idx: int, user_id: int) -> Dict[str, Any]:
        default_name_c = 0
        default_prof_c = 0

        name_c = _safe_int(self._get_slot_val(acc_idx, "name_color", default_name_c), default_name_c)
        if name_c < 0 or name_c >= len(NAME_AND_REPLY_COLORS):
            name_c = default_name_c

        name_bg = _safe_int(self._get_slot_val(acc_idx, "name_bg_emoji_id", DEFAULT_NAME_BG_EMOJI), 0)
        prof_c = _safe_int(self._get_slot_val(acc_idx, "profile_color", default_prof_c), default_prof_c)
        if prof_c < 0 or prof_c >= len(PROFILE_COLORS):
            prof_c = default_prof_c

        prof_bg = _safe_int(self._get_slot_val(acc_idx, "profile_bg_emoji_id", DEFAULT_PROFILE_BG_EMOJI), 0)
        em_id = _safe_int(self._get_slot_val(acc_idx, "emoji_status_id", DEFAULT_EMOJI_STATUS_ID), 0)
        prem = bool(self._get_slot_val(acc_idx, "premium", True))

        return {
            "user_id": user_id,
            "premium": prem,
            "emoji_status_id": em_id,
            "name_color": name_c,
            "name_bg_emoji_id": name_bg,
            "profile_color": prof_c,
            "profile_bg_emoji_id": prof_bg,
            "client_type": "AyuGram",
            "auth_key": self.get_setting("auth_key", "").strip(),
        }

    def get_cached_profile(self, uid: int) -> Optional[Dict[str, Any]]:
        if not uid or uid <= 0:
            return None
        snap = self._profiles_snapshot
        if snap:
            return snap.get(uid)
        with self._sync_lock:
            return self._profiles_cache.get(uid)

    def _update_snapshot(self):
        """Replace the lock-free snapshot with the current cache state.
        Safe for concurrent lock-free reads under CPython GIL."""
        self._profiles_snapshot = dict(self._profiles_cache)
        self._chats_snapshot = dict(self._chats_cache)

    def _parse_items_map(self, raw_data: Any, is_chat: bool = False) -> Dict[int, Dict[str, Any]]:
        result = {}
        if not raw_data:
            return result

        if isinstance(raw_data, list):
            for item in raw_data:
                if not isinstance(item, dict):
                    continue
                if is_chat:
                    k_id = _normalize_chat_id(item.get("chat_id") if "chat_id" in item else item.get("id"))
                else:
                    k_id = _safe_int(item.get("user_id") if "user_id" in item else item.get("id"))
                if k_id > 0:
                    result[k_id] = item
        elif isinstance(raw_data, dict):
            for k, v in raw_data.items():
                if isinstance(v, dict):
                    if is_chat:
                        k_id = _normalize_chat_id(v.get("chat_id") if "chat_id" in v else (v.get("id") if "id" in v else k))
                    else:
                        k_id = _safe_int(v.get("user_id") if "user_id" in v else (v.get("id") if "id" in v else k))
                    if k_id > 0:
                        result[k_id] = v
                else:
                    if is_chat:
                        k_id = _normalize_chat_id(k)
                    else:
                        k_id = _safe_int(k)
                    if k_id > 0:
                        result[k_id] = {"id": k_id, "data": v}

        return result

    def _patch_user_tl_object(self, u: Any) -> bool:
        if not u:
            return False
        try:
            uid = int(getattr(u, "id", 0) or 0)
        except Exception:
            return False

        if uid <= 0:
            return False

        if not _is_user(u):
            return False

        # Normalize video avatar flags so all accounts see animated avatars
        try:
            ph = getattr(u, "photo", None)
            if ph:
                v_sizes = getattr(ph, "video_sizes", None)
                has_v = bool(
                    getattr(ph, "has_video", False)
                    or (v_sizes and (hasattr(v_sizes, "isEmpty") and not v_sizes.isEmpty() or len(v_sizes) > 0))
                    or ((int(getattr(ph, "flags", 0) or 0) & 1) != 0)
                )
                if has_v:
                    ph.has_video = True
                    ph.flags = int(getattr(ph, "flags", 0) | 1)
        except Exception:
            pass

        # Lock-free hot-path: check snapshot first, fallback to live cache
        snap = self._profiles_snapshot
        profile = snap.get(uid) if snap else None
        if profile is None:
            with self._sync_lock:
                profile = self._profiles_cache.get(uid)

        if not profile:
            return False

        try:
            global TLRPC
            if TLRPC is None:
                from org.telegram.tgnet import TLRPC as _TLRPC
                TLRPC = _TLRPC

            nc = _safe_int(profile.get("name_color", 0))
            nbg = _safe_int(profile.get("name_bg_emoji_id", 0))
            prc = _safe_int(profile.get("profile_color", 0))
            pbg = _safe_int(profile.get("profile_bg_emoji_id", 0))
            em_id = _safe_int(profile.get("emoji_status_id", 0))

            pc_obj = _build_peer_color(nc, nbg)
            if pc_obj is not None:
                u.color = pc_obj

            prc_obj = _build_peer_color(prc, pbg)
            if prc_obj is not None:
                u.profile_color = prc_obj

            if em_id != 0:
                st = TLRPC.TL_emojiStatus()
                st.document_id = em_id
                u.emoji_status = st

            # Always set premium for all users (including own accounts)
            # so video avatars, emoji statuses and custom emoji are visible everywhere
            if bool(profile.get("premium", True)):
                u.premium = True

            return True
        except Exception:
            return False

    def _patch_full_user_tl_object(self, fu: Any, uid: int) -> bool:
        if not fu or not uid or uid <= 0:
            return False

        profile = self.get_cached_profile(uid)
        if not profile:
            return False

        try:
            nc = _safe_int(profile.get("name_color", 0))
            nbg = _safe_int(profile.get("name_bg_emoji_id", 0))
            prc = _safe_int(profile.get("profile_color", 0))
            pbg = _safe_int(profile.get("profile_bg_emoji_id", 0))

            prc_obj = _build_peer_color(prc, pbg)
            if prc_obj is not None:
                fu.profile_color = prc_obj

            if hasattr(fu, "color"):
                nc_obj = _build_peer_color(nc, nbg)
                if nc_obj is not None:
                    fu.color = nc_obj

            if hasattr(fu, "user") and fu.user and _is_user(fu.user):
                self._patch_user_tl_object(fu.user)

            return True
        except Exception:
            return False

    def _patch_chat_tl_object(self, chat: Any) -> bool:
        if not chat:
            return False
        try:
            raw_id = getattr(chat, "id", 0)
            cid = _normalize_chat_id(raw_id)
        except Exception:
            return False

        if cid <= 0:
            return False

        if not _is_chat(chat):
            return False

        # Normalize video avatar flags
        try:
            ph = getattr(chat, "photo", None)
            if ph:
                v_sizes = getattr(ph, "video_sizes", None)
                has_v = bool(
                    getattr(ph, "has_video", False)
                    or (v_sizes and (hasattr(v_sizes, "isEmpty") and not v_sizes.isEmpty() or len(v_sizes) > 0))
                    or ((int(getattr(ph, "flags", 0) or 0) & 1) != 0)
                )
                if has_v:
                    ph.has_video = True
                    ph.flags = int(getattr(ph, "flags", 0) | 1)
        except Exception:
            pass

        snap = getattr(self, "_chats_snapshot", None)
        profile = snap.get(cid) if snap else None
        if profile is None:
            with self._sync_lock:
                profile = self._chats_cache.get(cid)

        if not profile:
            return False

        try:
            global TLRPC
            if TLRPC is None:
                from org.telegram.tgnet import TLRPC as _TLRPC
                TLRPC = _TLRPC

            nc = _safe_int(profile.get("name_color", 0))
            nbg = _safe_int(profile.get("name_bg_emoji_id", 0))
            prc = _safe_int(profile.get("profile_color", 0))
            pbg = _safe_int(profile.get("profile_bg_emoji_id", 0))
            em_id = _safe_int(profile.get("emoji_status_id", 0))
            boost_lvl = _safe_int(profile.get("boost_level", 0))

            pc_obj = _build_peer_color(nc, nbg)
            if pc_obj is not None:
                chat.color = pc_obj

            prc_obj = _build_peer_color(prc, pbg)
            if prc_obj is not None:
                chat.profile_color = prc_obj

            if em_id != 0:
                st = TLRPC.TL_emojiStatus()
                st.document_id = em_id
                chat.emoji_status = st

            if boost_lvl > 0:
                chat.level = boost_lvl

            return True
        except Exception:
            return False

    def _patch_full_chat_tl_object(self, fc: Any, chat_id: int) -> bool:
        if not fc:
            return False
        cid = _normalize_chat_id(chat_id or getattr(fc, "id", 0))
        if cid <= 0:
            return False

        snap = getattr(self, "_chats_snapshot", None)
        profile = snap.get(cid) if snap else None
        if profile is None:
            with self._sync_lock:
                profile = self._chats_cache.get(cid)

        if not profile:
            return False

        try:
            global TLRPC
            if TLRPC is None:
                from org.telegram.tgnet import TLRPC as _TLRPC
                TLRPC = _TLRPC

            nc = _safe_int(profile.get("name_color", 0))
            nbg = _safe_int(profile.get("name_bg_emoji_id", 0))
            prc = _safe_int(profile.get("profile_color", 0))
            pbg = _safe_int(profile.get("profile_bg_emoji_id", 0))
            em_id = _safe_int(profile.get("emoji_status_id", 0))
            boost_lvl = _safe_int(profile.get("boost_level", 0))

            prc_obj = _build_peer_color(prc, pbg)
            if prc_obj is not None:
                fc.profile_color = prc_obj

            if hasattr(fc, "color"):
                nc_obj = _build_peer_color(nc, nbg)
                if nc_obj is not None:
                    fc.color = nc_obj

            if em_id != 0:
                st = TLRPC.TL_emojiStatus()
                st.document_id = em_id
                fc.custom_status = st
                fc.emoji_status = st

            if boost_lvl > 0:
                fc.boosts_applied = boost_lvl

            if hasattr(fc, "chat") and fc.chat and _is_chat(fc.chat):
                self._patch_chat_tl_object(fc.chat)

            return True
        except Exception:
            return False

    def _register_xposed_hooks(self):
        try:
            MessagesControllerClass = find_class("org.telegram.messenger.MessagesController")
            plugin_self = self

            if MessagesControllerClass:
                class GetUserHook(MethodHook):
                    def after_hooked_method(self, param):
                        try:
                            user_obj = param.getResult()
                            if user_obj and _is_user(user_obj):
                                plugin_self._patch_user_tl_object(user_obj)
                        except Exception:
                            pass

                class GetUserFullHook(MethodHook):
                    def after_hooked_method(self, param):
                        try:
                            fu_obj = param.getResult()
                            if fu_obj:
                                uid = getattr(fu_obj, "id", 0)
                                if uid:
                                    plugin_self._patch_full_user_tl_object(fu_obj, int(uid))
                        except Exception:
                            pass

                class GetChatHook(MethodHook):
                    def after_hooked_method(self, param):
                        try:
                            chat_obj = param.getResult()
                            if chat_obj and _is_chat(chat_obj):
                                plugin_self._patch_chat_tl_object(chat_obj)
                        except Exception:
                            pass

                class GetChatFullHook(MethodHook):
                    def after_hooked_method(self, param):
                        try:
                            fc_obj = param.getResult()
                            if fc_obj:
                                cid = getattr(fc_obj, "id", 0)
                                if cid:
                                    plugin_self._patch_full_chat_tl_object(fc_obj, int(cid))
                        except Exception:
                            pass

                for m in _get_class_methods(MessagesControllerClass):
                    try:
                        m_name = m.getName()
                        p_types = m.getParameterTypes()
                        if m_name == "getUser" and len(p_types) == 1:
                            p0_name = p_types[0].getName()
                            if p0_name in ("long", "java.lang.Long", "int", "java.lang.Integer"):
                                m.setAccessible(True)
                                unhook = self.hook_method(m, GetUserHook())
                                if unhook:
                                    self._xposed_unhooks.append(unhook)
                        elif m_name == "getUserFull" and len(p_types) == 1:
                            m.setAccessible(True)
                            unhook = self.hook_method(m, GetUserFullHook())
                            if unhook:
                                self._xposed_unhooks.append(unhook)
                        elif m_name == "getChat" and len(p_types) == 1:
                            p0_name = p_types[0].getName()
                            if p0_name in ("long", "java.lang.Long", "int", "java.lang.Integer"):
                                m.setAccessible(True)
                                unhook = self.hook_method(m, GetChatHook())
                                if unhook:
                                    self._xposed_unhooks.append(unhook)
                        elif m_name == "getChatFull" and len(p_types) == 1:
                            m.setAccessible(True)
                            unhook = self.hook_method(m, GetChatFullHook())
                            if unhook:
                                self._xposed_unhooks.append(unhook)
                    except Exception as e:
                        log(f"SyncProfile: hook MessagesController method {m} error: {e}")

            # Hook UserObject.hasAnimatedAvatar so video avatars always play
            UserObjectClass = find_class("org.telegram.messenger.UserObject")
            if UserObjectClass:
                class UserHasAnimatedAvatarHook(MethodHook):
                    def after_hooked_method(self, param):
                        try:
                            if param.getResult():
                                return
                            args = getattr(param, "args", None)
                            if not args or len(args) == 0:
                                return
                            ph = getattr(args[0], "photo", None)
                            if not ph:
                                return
                            v_sizes = getattr(ph, "video_sizes", None)
                            has_v = bool(
                                getattr(ph, "has_video", False)
                                or (v_sizes and (hasattr(v_sizes, "isEmpty") and not v_sizes.isEmpty() or len(v_sizes) > 0))
                                or ((int(getattr(ph, "flags", 0) or 0) & 1) != 0)
                            )
                            if has_v:
                                ph.has_video = True
                                param.setResult(True)
                        except Exception:
                            pass

                for m in _get_class_methods(UserObjectClass):
                    try:
                        if m.getName() in ("hasAnimatedAvatar", "canAnimateAvatar"):
                            m.setAccessible(True)
                            un = self.hook_method(m, UserHasAnimatedAvatarHook())
                            if un:
                                self._xposed_unhooks.append(un)
                    except Exception:
                        pass

            # Hook ChatMessageCell and ChatActivity to capture the selected message for context menus
            ChatMessageCellClass = find_class("org.telegram.ui.Cells.ChatMessageCell")
            if ChatMessageCellClass:
                class ChatMessageCellMenuHook(MethodHook):
                    def before_hooked_method(self, param):
                        try:
                            this_cell = getattr(param, "thisObject", None)
                            if this_cell is not None:
                                mo = plugin_self._resolve_message_object(this_cell)
                                if mo is not None:
                                    plugin_self._last_selected_message = mo
                        except Exception:
                            pass

                for m in _get_class_methods(ChatMessageCellClass):
                    try:
                        if m.getName() in ("createMenu", "showPopupMenu", "onLongClick", "showMenu", "openMenu"):
                            m.setAccessible(True)
                            un = self.hook_method(m, ChatMessageCellMenuHook())
                            if un:
                                self._xposed_unhooks.append(un)
                    except Exception:
                        pass

            ChatActivityClass = find_class("org.telegram.ui.ChatActivity")
            if ChatActivityClass:
                class ChatActivityMenuHook(MethodHook):
                    def before_hooked_method(self, param):
                        try:
                            args = getattr(param, "args", None)
                            if args:
                                for arg in args:
                                    mo = plugin_self._resolve_message_object(arg)
                                    if mo is not None:
                                        plugin_self._last_selected_message = mo
                                        return
                            this_act = getattr(param, "thisObject", None)
                            if this_act is not None:
                                mo = plugin_self._resolve_message_object(this_act)
                                if mo is not None:
                                    plugin_self._last_selected_message = mo
                        except Exception:
                            pass

                for m in _get_class_methods(ChatActivityClass):
                    try:
                        if m.getName() in ("createMenu", "showMenuForCell", "showPopupMenu", "onItemClick", "processSelectedOption"):
                            m.setAccessible(True)
                            un = self.hook_method(m, ChatActivityMenuHook())
                            if un:
                                self._xposed_unhooks.append(un)
                    except Exception:
                        pass

            log(f"SyncProfile: Установлено {len(self._xposed_unhooks)} хуков.")
        except Exception as e:
            log(f"SyncProfile: Ошибка регистрации хуков: {e}")

    def _unregister_xposed_hooks(self):
        for unhook in self._xposed_unhooks:
            try:
                self.unhook_method(unhook)
            except Exception:
                pass
        self._xposed_unhooks.clear()

    def _initial_background_sync(self):
        time.sleep(1.0)
        if not self._is_running:
            return
        if self.get_setting("enable_sync", True):
            last_ts = self.get_setting("_last_sync_timestamp", 0)
            if not self._profiles_cache or last_ts == 0:
                self._sync_database(show_bulletin=False, force_clean=False)
            else:
                self.sync_delta_updates_from_server(show_bulletin=False)

    async def _async_initial_background_sync(self):
        await asyncio.sleep(1.0)
        if not self._is_running:
            return
        if self.get_setting("enable_sync", True):
            last_ts = self.get_setting("_last_sync_timestamp", 0)
            if not self._profiles_cache or last_ts == 0:
                await self._async_sync_database(show_bulletin=False, force_clean=False)
            else:
                await self._async_sync_delta_updates(show_bulletin=False)

    def _keep_alive_sync_loop(self):
        while self._is_running:
            time.sleep(60)
            if not self._is_running:
                break
            if self.get_setting("enable_sync", True):
                self.sync_delta_updates_from_server(show_bulletin=False)

    async def _async_keep_alive_sync_loop(self):
        while self._is_running:
            await asyncio.sleep(60)
            if not self._is_running:
                break
            if self.get_setting("enable_sync", True):
                await self._async_sync_delta_updates(show_bulletin=False)

    async def _async_sync_database(self, show_bulletin: bool = False, force_clean: bool = True):
        loop = asyncio.get_running_loop()
        await loop.run_in_executor(
            None,
            lambda: self._sync_database(show_bulletin=show_bulletin, force_clean=force_clean)
        )

    def _sync_database(self, show_bulletin: bool = False, force_clean: bool = True):
        server_url = self.get_setting("server_url", DEFAULT_SERVER_URL).rstrip("/")
        cookie_val = self.get_setting("custom_cookie", DEFAULT_SECRET_COOKIE).strip()

        try:
            url = f"{server_url}/api/profiles/all"
            headers = {
                "User-Agent": f"SyncProfile/{__version__}",
                "Cookie": f"{COOKIE_NAME}={cookie_val}",
            }
            last_ts = self.get_setting("_last_sync_timestamp", 0)
            if not force_clean and last_ts > 0:
                headers["If-Modified-Since"] = str(last_ts)

            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=8) as resp:
                if resp.status == 304:
                    if show_bulletin:
                        bulletins.show_info("Синхронизация: База данных уже актуальна.")
                    return

                if resp.status == 200:
                    data = json.loads(resp.read().decode("utf-8"))
                    profiles_raw = data.get("profiles", {})
                    if isinstance(profiles_raw, dict):
                        profiles_list = list(profiles_raw.values())
                    else:
                        profiles_list = profiles_raw
                    server_ts = data.get("sync_time") or data.get("server_time") or data.get("timestamp") or int(time.time())

                    with self._sync_lock:
                        if force_clean:
                            my_uids = self._get_my_active_uids()
                            preserved = {uid: p for uid, p in self._profiles_cache.items() if uid in my_uids}
                            self._profiles_cache = preserved

                        for p in profiles_list:
                            uid = p.get("user_id")
                            if uid:
                                self._profiles_cache[int(uid)] = p
                        self._cache_dirty = True

                    self._update_snapshot()
                    self.set_setting("_last_sync_timestamp", server_ts, reload_settings=False)
                    self._save_local_profiles_cache()
                    self._apply_all_to_all_accounts()

                    if show_bulletin:
                        bulletins.show_success(f"База обновлена! Загружено профилей: {len(profiles_list)}")
                    return

            if show_bulletin:
                bulletins.show_error(f"Сервер ответил кодом: {resp.status}")
        except urllib.error.HTTPError as he:
            if he.code == 304:
                if show_bulletin:
                    bulletins.show_info("Синхронизация: База данных уже актуальна.")
                return
            logger.error(f"Sync database HTTP error: {he.code}")
            if show_bulletin:
                bulletins.show_error(f"HTTP ошибка: {he.code}")
        except Exception as e:
            logger.error(f"Sync database error: {e}")
            if show_bulletin:
                bulletins.show_error(f"Ошибка загрузки базы: {e}")

    def sync_delta_updates_from_server(self, show_bulletin: bool = True):
        threading.Thread(target=self._sync_delta_worker, args=(show_bulletin,), daemon=True).start()

    async def _async_sync_delta_updates(self, show_bulletin: bool = False):
        loop = asyncio.get_running_loop()
        await loop.run_in_executor(None, lambda: self._sync_delta_worker(show_bulletin))

    def _sync_delta_worker(self, show_bulletin: bool):
        server_url = self.get_setting("server_url", DEFAULT_SERVER_URL).rstrip("/")
        cookie_val = self.get_setting("custom_cookie", DEFAULT_SECRET_COOKIE).strip()
        last_ts = self.get_setting("_last_sync_timestamp", 0)

        try:
            url = f"{server_url}/api/profiles/updates?since={last_ts}"
            headers = {
                "User-Agent": f"SyncProfile/{__version__}",
                "Cookie": f"{COOKIE_NAME}={cookie_val}",
            }
            req = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(req, timeout=6) as resp:
                if resp.status == 304:
                    if show_bulletin:
                        bulletins.show_info("Изменений нет — профили актуальны.")
                    return

                if resp.status == 200:
                    data = json.loads(resp.read().decode("utf-8"))
                    new_cache = data.get("profiles", {})
                    new_ts = data.get("sync_time") or data.get("server_time") or data.get("timestamp") or int(time.time())

                    if new_cache:
                        updated_ids = set()
                        with self._sync_lock:
                            for uid_str, p in new_cache.items():
                                try:
                                    u_id = int(uid_str)
                                    self._profiles_cache[u_id] = p
                                    updated_ids.add(u_id)
                                    self._cache_dirty = True
                                except ValueError:
                                    continue
                        self._update_snapshot()
                        self.set_setting("_last_sync_timestamp", new_ts, reload_settings=False)
                        self._save_local_profiles_cache()
                        updated_list = list(updated_ids)

                        plugin_self = self
                        def on_delta_applied(uids=updated_list):
                            try:
                                from org.telegram.messenger import MessagesController, UserConfig
                                sel_acc = getattr(UserConfig, "selectedAccount", 0)
                                mc = MessagesController.getInstance(sel_acc)
                                if mc and uids:
                                    for u_id in uids:
                                        try:
                                            u_obj = mc.getUser(u_id)
                                            if u_obj and _is_user(u_obj):
                                                plugin_self._patch_user_tl_object(u_obj)
                                        except Exception:
                                            pass
                            except Exception:
                                pass
                        run_on_ui_thread(on_delta_applied)

                        if show_bulletin:
                            bulletins.show_success(f"Получено {len(new_cache)} обновлений профилей!")
                    else:
                        self.set_setting("_last_sync_timestamp", new_ts, reload_settings=False)
                        if show_bulletin:
                            bulletins.show_info("Изменений нет.")
                    return
            if show_bulletin:
                bulletins.show_error(f"Сервер ответил кодом {resp.status}")
        except urllib.error.HTTPError as he:
            if he.code == 304:
                if show_bulletin:
                    bulletins.show_info("Изменений нет — профили актуальны.")
                return
            logger.error(f"Delta sync HTTP error: {he.code}")
            if show_bulletin:
                bulletins.show_error(f"HTTP ошибка: {he.code}")
        except Exception as e:
            logger.error(f"Delta sync error: {e}")
            if show_bulletin:
                bulletins.show_error(f"Ошибка синхронизации: {e}")

    def _apply_all_to_all_accounts(self):
        def ui_update_task():
            try:
                from org.telegram.messenger import UserConfig
                global TLRPC
                if TLRPC is None:
                    try:
                        from org.telegram.tgnet import TLRPC as _TLRPC
                        TLRPC = _TLRPC
                    except Exception:
                        pass

                active_accs = self._get_active_accounts_data()
                for acc_info in active_accs:
                    acc_idx = acc_info.get("acc_idx", 0)
                    my_uid = acc_info.get("user_id", 0)
                    if my_uid != 0:
                        my_p = self._get_profile_dict_for_slot(acc_idx, my_uid)
                        with self._sync_lock:
                            self._profiles_cache[my_uid] = my_p
                            self._cache_dirty = True
                self._update_snapshot()

                for acc_info in active_accs:
                    acc = acc_info.get("acc_idx", 0)
                    my_acc_uid = acc_info.get("user_id", 0)
                    if my_acc_uid == 0:
                        continue
                    try:
                        u_cfg = UserConfig.getInstance(acc)
                        if not u_cfg or not u_cfg.isClientActivated():
                            continue

                        curr_u = u_cfg.getCurrentUser()
                        if curr_u:
                            slot_p = self._get_profile_dict_for_slot(acc, my_acc_uid)

                            nc = _safe_int(slot_p.get("name_color", 0))
                            nbg = _safe_int(slot_p.get("name_bg_emoji_id", 0))
                            prc = _safe_int(slot_p.get("profile_color", 0))
                            pbg = _safe_int(slot_p.get("profile_bg_emoji_id", 0))

                            pc_obj = _build_peer_color(nc, nbg)
                            if pc_obj is not None:
                                curr_u.color = pc_obj

                            prc_obj = _build_peer_color(prc, pbg)
                            if prc_obj is not None:
                                curr_u.profile_color = prc_obj

                            em_id = _safe_int(slot_p.get("emoji_status_id", 0))
                            if em_id != 0 and TLRPC is not None:
                                st = TLRPC.TL_emojiStatus()
                                st.document_id = em_id
                                curr_u.emoji_status = st

                    except Exception as e:
                        log(f"SyncProfile: _apply_all_to_all_accounts acc {acc} error: {e}")

                sel_acc = getattr(UserConfig, "selectedAccount", 0)
                try:
                    from org.telegram.messenger import MessagesController
                    mc = MessagesController.getInstance(sel_acc)
                    if mc:
                        for acc_info2 in active_accs:
                            uid2 = acc_info2.get("user_id", 0)
                            if uid2 > 0:
                                u_obj2 = mc.getUser(uid2)
                                if u_obj2 and _is_user(u_obj2):
                                    self._patch_user_tl_object(u_obj2)
                except Exception:
                    pass

            except Exception as e:
                log(f"SyncProfile: _apply_all_to_all_accounts error: {e}")

        run_on_ui_thread(ui_update_task)

    def push_specific_account(self, acc_idx: int, show_ui_bulletin: bool = True):
        uid = 0
        name = f"Аккаунт {acc_idx + 1}"
        try:
            from org.telegram.messenger import UserConfig
            u_c = UserConfig.getInstance(acc_idx)
            if u_c:
                uid = int(u_c.getClientUserId() or 0)
                cu = u_c.getCurrentUser()
                if cu:
                    name = str(getattr(cu, "first_name", "") or name)
        except Exception:
            pass

        if uid == 0:
            if show_ui_bulletin:
                bulletins.show_error(f"Не удалось определить Telegram ID для аккаунта {acc_idx + 1}")
            return

        payload = self._get_profile_dict_for_slot(acc_idx, uid)
        def worker():
            server_url = self.get_setting("server_url", DEFAULT_SERVER_URL).rstrip("/")
            cookie_val = self.get_setting("custom_cookie", DEFAULT_SECRET_COOKIE).strip()
            try:
                url = f"{server_url}/api/profile"
                data = json.dumps(payload).encode("utf-8")
                headers = {
                    "Content-Type": "application/json",
                    "User-Agent": f"SyncProfile/{__version__}",
                    "Cookie": f"{COOKIE_NAME}={cookie_val}",
                }
                req = urllib.request.Request(url, data=data, headers=headers, method="POST")
                with urllib.request.urlopen(req, timeout=6) as resp:
                    if resp.status == 200:
                        with self._sync_lock:
                            self._profiles_cache[uid] = payload
                            self._cache_dirty = True
                        self._update_snapshot()
                        self._save_local_profiles_cache()
                        self._apply_all_to_all_accounts()
                        if show_ui_bulletin:
                            bulletins.show_success(
                                f"🚀 Профиль {name} (ID: {uid}) опубликован!\nЦвет: #{payload['name_color']} | Обложка: #{payload['profile_color']}"
                            )
                        return
                if show_ui_bulletin:
                    bulletins.show_error(f"Ошибка публикации: Сервер вернул код {resp.status}")
            except urllib.error.HTTPError as he:
                if he.code == 403:
                    if show_ui_bulletin:
                        bulletins.show_error("Ошибка 403: Неверный токен авторизации (auth_key).")
                elif he.code == 401:
                    if show_ui_bulletin:
                        bulletins.show_error("Ошибка 401: Доступ заблокирован (проверьте Cookie).")
                else:
                    if show_ui_bulletin:
                        bulletins.show_error(f"Ошибка сервера: {he.code}")
            except Exception as e:
                logger.error(f"Ошибка отправки профиля: {e}")
                if show_ui_bulletin:
                    bulletins.show_error(f"Сетевая ошибка: {e}")

        threading.Thread(target=worker, daemon=True).start()

    def push_all_accounts(self, show_ui_bulletin: bool = True):
        active_accs = self._get_active_accounts_data()
        if not active_accs:
            if show_ui_bulletin:
                bulletins.show_error("Нет активных аккаунтов для отправки.")
            return

        def worker():
            server_url = self.get_setting("server_url", DEFAULT_SERVER_URL).rstrip("/")
            cookie_val = self.get_setting("custom_cookie", DEFAULT_SECRET_COOKIE).strip()
            success_count = 0
            errors = []

            for acc_info in active_accs:
                acc_idx = acc_info["acc_idx"]
                uid = acc_info["user_id"]
                name = acc_info["name"]

                payload = self._get_profile_dict_for_slot(acc_idx, uid)
                try:
                    url = f"{server_url}/api/profile"
                    data = json.dumps(payload).encode("utf-8")
                    headers = {
                        "Content-Type": "application/json",
                        "User-Agent": f"SyncProfile/{__version__}",
                        "Cookie": f"{COOKIE_NAME}={cookie_val}",
                    }
                    req = urllib.request.Request(url, data=data, headers=headers, method="POST")
                    with urllib.request.urlopen(req, timeout=5) as resp:
                        if resp.status == 200:
                            success_count += 1
                            with self._sync_lock:
                                self._profiles_cache[uid] = payload
                                self._cache_dirty = True
                        else:
                            errors.append(f"{name}: HTTP {resp.status}")
                except Exception as e:
                    errors.append(f"{name}: {str(e)[:30]}")

            if success_count > 0:
                self._update_snapshot()
                self._save_local_profiles_cache()
                self._apply_all_to_all_accounts()

            if show_ui_bulletin:
                if success_count == len(active_accs):
                    bulletins.show_success(f"🎉 Все аккаунты ({success_count}) успешно опубликованы на сервере!")
                elif success_count > 0:
                    bulletins.show_info(f"Опубликовано {success_count}/{len(active_accs)}. Ошибки:\n" + "\n".join(errors))
                else:
                    bulletins.show_error(f"Не удалось опубликовать ни один аккаунт:\n" + "\n".join(errors))

        threading.Thread(target=worker, daemon=True).start()

    def _save_local_profiles_cache(self, force: bool = False):
        if not force and not self._cache_dirty:
            return
        try:
            with self._sync_lock:
                cache_copy = {
                    "profiles": dict(self._profiles_cache),
                    "chats": dict(self._chats_cache),
                }
                self._cache_dirty = False

            if HAS_ZWYLIB and self._json_cache_file is not None:
                self._json_cache_file.content = cache_copy
                self._json_cache_file.write()
                return

            try:
                import os
                cache_path = "sync_profiles_cache.json"
                with open(cache_path, "w", encoding="utf-8") as f:
                    json.dump(cache_copy, f, ensure_ascii=False)
                return
            except Exception:
                pass

            cache_str = json.dumps(cache_copy, ensure_ascii=False)
            self.set_setting("_local_profiles_json", cache_str, reload_settings=False)
        except Exception as e:
            logger.error(f"Save cache error: {e}")

    def _load_local_profiles_cache(self):
        try:
            data = None
            if HAS_ZWYLIB and self._json_cache_file is not None:
                try:
                    self._json_cache_file.read()
                    data = self._json_cache_file.content
                except Exception:
                    data = None

            if not isinstance(data, dict):
                import os
                cache_path = "sync_profiles_cache.json"
                if os.path.exists(cache_path):
                    try:
                        with open(cache_path, "r", encoding="utf-8") as f:
                            data = json.load(f)
                    except Exception:
                        data = None

            if not isinstance(data, dict):
                saved_str = self.get_setting("_local_profiles_json", "{}")
                if saved_str and saved_str != "{}":
                    try:
                        data = json.loads(saved_str)
                    except Exception:
                        data = None

            if isinstance(data, dict):
                with self._sync_lock:
                    if "profiles" in data or "chats" in data:
                        p_map = data.get("profiles", {})
                        if isinstance(p_map, dict):
                            for uid_str, p_data in p_map.items():
                                if str(uid_str).isdigit():
                                    self._profiles_cache[int(uid_str)] = p_data
                        c_map = data.get("chats", {})
                        if isinstance(c_map, dict):
                            for cid_str, c_data in c_map.items():
                                cid_norm = _normalize_chat_id(cid_str)
                                if cid_norm > 0:
                                    self._chats_cache[cid_norm] = c_data
                    else:
                        # Legacy flat dict
                        for uid_str, p_data in data.items():
                            if str(uid_str).isdigit():
                                self._profiles_cache[int(uid_str)] = p_data
                self._update_snapshot()
        except Exception as e:
            logger.error(f"Load cache error: {e}")

    def _register_menu_items(self):
        try:
            if not hasattr(self, "add_menu_item") or MenuItemType is None or MenuItemData is None:
                return

            profile_menu_type = None
            if hasattr(MenuItemType, "__members__") and isinstance(MenuItemType.__members__, dict):
                for name in ("PROFILE_ACTION_MENU", "PROFILE_MENU", "USER_ACTION_MENU", "USER_PROFILE", "PROFILE"):
                    if name in MenuItemType.__members__:
                        profile_menu_type = MenuItemType.__members__[name]
                        break
            if profile_menu_type is None:
                for name in ("PROFILE_ACTION_MENU", "PROFILE_MENU", "USER_ACTION_MENU", "USER_PROFILE", "PROFILE"):
                    try:
                        val = getattr(MenuItemType, name, None)
                        if val is not None:
                            profile_menu_type = val
                            break
                    except Exception:
                        pass

            msg_menu_type = None
            if hasattr(MenuItemType, "__members__") and isinstance(MenuItemType.__members__, dict):
                for name in ("MESSAGE_CONTEXT_MENU", "MESSAGE_ACTION_MENU", "MESSAGE", "CHAT_ACTION_MENU"):
                    if name in MenuItemType.__members__:
                        msg_menu_type = MenuItemType.__members__[name]
                        break
            if msg_menu_type is None:
                for name in ("MESSAGE_CONTEXT_MENU", "MESSAGE_ACTION_MENU", "MESSAGE", "CHAT_ACTION_MENU"):
                    try:
                        val = getattr(MenuItemType, name, None)
                        if val is not None:
                            msg_menu_type = val
                            break
                    except Exception:
                        pass

            if profile_menu_type is not None:
                def _make_prof_item(item_id: str, text: str, icon: str, on_click: Any, priority: int = 100):
                    for c in (
                        lambda: MenuItemData(menu_type=profile_menu_type, text=text, on_click=on_click, icon=icon, priority=priority),
                        lambda: MenuItemData(id=item_id, type=profile_menu_type, text=text, icon=icon, on_click=on_click),
                        lambda: MenuItemData(menu_type=profile_menu_type, text=text, on_click=on_click, icon=icon),
                        lambda: MenuItemData(type=profile_menu_type, text=text, icon=icon, on_click=on_click),
                    ):
                        try:
                            return c()
                        except Exception:
                            continue
                    return None

                item1 = _make_prof_item("refresh_profile", "🔄 Обновить профиль (SyncProfile)", "msg_sync", self._on_refresh_single_profile_click, 110)
                if item1:
                    try:
                        self.add_menu_item(item1)
                    except Exception:
                        pass

                item2 = _make_prof_item("profile_info", "⭐ SyncProfile: Инфо о профиле", "msg_info", self._on_profile_menu_click, 100)
                if item2:
                    try:
                        self.add_menu_item(item2)
                    except Exception:
                        pass

            if msg_menu_type is not None:
                def _make_msg_item(item_id: str, text: str, icon: str, on_click: Any, priority: int = 50):
                    for c in (
                        lambda: MenuItemData(menu_type=msg_menu_type, text=text, on_click=on_click, icon=icon, priority=priority),
                        lambda: MenuItemData(id=item_id, type=msg_menu_type, text=text, icon=icon, on_click=on_click),
                        lambda: MenuItemData(menu_type=msg_menu_type, text=text, on_click=on_click, icon=icon),
                        lambda: MenuItemData(type=msg_menu_type, text=text, icon=icon, on_click=on_click),
                    ):
                        try:
                            return c()
                        except Exception:
                            continue
                    return None

                item3 = _make_msg_item("copy_emoji_id", "🆔 Скопировать Emoji Document ID", "msg_emoji", self._on_copy_emoji_id_click, 50)
                if item3:
                    try:
                        self.add_menu_item(item3)
                    except Exception:
                        pass
        except Exception as e:
            logger.warning(f"_register_menu_items error: {e}")

    def _extract_user_from_menu_args(self, *args, **kwargs):
        user = None
        user_id = 0
        if "user" in kwargs:
            user = kwargs["user"]
        elif "user_id" in kwargs:
            try: user_id = int(kwargs["user_id"])
            except Exception: pass
        elif "userId" in kwargs:
            try: user_id = int(kwargs["userId"])
            except Exception: pass

        if not user and not user_id and args:
            for arg in args:
                if isinstance(arg, dict):
                    user = arg.get("user")
                    if not user and "user_id" in arg:
                        try: user_id = int(arg["user_id"])
                        except Exception: pass
                    if not user and "userId" in arg:
                        try: user_id = int(arg["userId"])
                        except Exception: pass
                    if user or user_id:
                        break
                elif isinstance(arg, int) and arg > 0:
                    user_id = arg
                    break
                elif hasattr(arg, "id") and not hasattr(arg, "getParentActivity") and not hasattr(arg, "findViewById"):
                    user = arg
                    break
                elif hasattr(arg, "getUser"):
                    try:
                        u = arg.getUser()
                        if u:
                            user = u
                            break
                    except Exception:
                        pass

        if not user and not user_id:
            try:
                from org.telegram.ui import LaunchActivity
                frag = None
                if hasattr(LaunchActivity, "getLastFragment"):
                    frag = LaunchActivity.getLastFragment()
                if frag and hasattr(frag, "getUser"):
                    try: user = frag.getUser()
                    except Exception: pass
                if not user and frag and hasattr(frag, "getCurrentUser"):
                    try: user = frag.getCurrentUser()
                    except Exception: pass
                if not user and frag and hasattr(frag, "user_id"):
                    try: user_id = int(getattr(frag, "user_id", 0) or 0)
                    except Exception: pass
                if not user and frag and hasattr(frag, "userId"):
                    try: user_id = int(getattr(frag, "userId", 0) or 0)
                    except Exception: pass
            except Exception:
                pass

        if user and not user_id:
            user_id = int(getattr(user, "id", 0) or 0)
        return user, user_id

    def _resolve_message_object(self, obj: Any, depth: int = 0) -> Any:
        if obj is None or depth > 4:
            return None

        # Direct MessageObject (has messageOwner or (has entities and media))
        if hasattr(obj, "messageOwner") and (
            hasattr(obj, "getId") or hasattr(obj, "getDialogId") or hasattr(obj, "messageText") or hasattr(obj, "caption") or hasattr(obj, "messageOwner")
        ):
            return obj

        # ChatMessageCell or any object with getMessageObject()
        if hasattr(obj, "getMessageObject"):
            try:
                mo = obj.getMessageObject()
                if mo is not None:
                    return mo
            except Exception:
                pass

        # ChatActionCell or view with currentMessageObject or messageObject
        if hasattr(obj, "currentMessageObject"):
            val = getattr(obj, "currentMessageObject", None)
            if val is not None:
                return val
        if hasattr(obj, "messageObject"):
            val = getattr(obj, "messageObject", None)
            if val is not None:
                return val

        # Fragment / ChatActivity with selectedObject or getSelectedObject()
        if hasattr(obj, "selectedObject"):
            val = getattr(obj, "selectedObject", None)
            if val is not None:
                return val
        if hasattr(obj, "getSelectedObject"):
            try:
                val = obj.getSelectedObject()
                if val is not None:
                    return val
            except Exception:
                pass
        if hasattr(obj, "contextMenuMessageObject"):
            val = getattr(obj, "contextMenuMessageObject", None)
            if val is not None:
                return val
        if hasattr(obj, "selectedMessage"):
            val = getattr(obj, "selectedMessage", None)
            if val is not None:
                return val

        # ChatActivity selectedObjects map / collection
        if hasattr(obj, "selectedObjects"):
            so = getattr(obj, "selectedObjects", None)
            if so is not None:
                if isinstance(so, dict):
                    for v in so.values():
                        res = self._resolve_message_object(v, depth + 1)
                        if res is not None:
                            return res
                elif hasattr(so, "values"):
                    try:
                        vals = so.values()
                        arr = vals.toArray() if hasattr(vals, "toArray") else list(vals)
                        for v in arr:
                            res = self._resolve_message_object(v, depth + 1)
                            if res is not None:
                                return res
                    except Exception:
                        pass

        # TLRPC.Message / TL_message (has id, and entities or media or message)
        if hasattr(obj, "id") and (hasattr(obj, "entities") or hasattr(obj, "media") or hasattr(obj, "message")):
            return obj

        # Dict unwrapping
        if isinstance(obj, dict):
            for k in ("message", "messageObject", "message_object", "msg", "cell", "fragment", "selectedObject", "obj", "object", "item"):
                if k in obj and obj[k] is not None:
                    res = self._resolve_message_object(obj[k], depth + 1)
                    if res is not None:
                        return res
            for v in obj.values():
                res = self._resolve_message_object(v, depth + 1)
                if res is not None:
                    return res

        # List / tuple / TL_vector unwrapping
        if isinstance(obj, (list, tuple)):
            for item in obj:
                res = self._resolve_message_object(item, depth + 1)
                if res is not None:
                    return res

        # Android View: getTag()
        if hasattr(obj, "getTag"):
            try:
                tag = obj.getTag()
                if tag is not None and tag != obj:
                    res = self._resolve_message_object(tag, depth + 1)
                    if res is not None:
                        return res
            except Exception:
                pass

        # Android View: getContext() -> LaunchActivity / ChatActivity
        if hasattr(obj, "getContext"):
            try:
                ctx = obj.getContext()
                if ctx is not None:
                    if hasattr(ctx, "getActionBarLayout"):
                        abl = ctx.getActionBarLayout()
                        if abl and hasattr(abl, "getLastFragment"):
                            res = self._resolve_message_object(abl.getLastFragment(), depth + 1)
                            if res is not None:
                                return res
                    res = self._resolve_message_object(ctx, depth + 1)
                    if res is not None:
                        return res
            except Exception:
                pass

        return None

    def _extract_message_from_menu_args(self, *args, **kwargs) -> Any:
        # 1. Check keyword arguments
        for k in (
            "message", "messageObject", "message_object", "msg", "cell", "view",
            "fragment", "dialog", "chatActivity", "chat_activity", "selectedObject",
            "selected_object", "obj", "object", "item"
        ):
            if k in kwargs and kwargs[k] is not None:
                mo = self._resolve_message_object(kwargs[k])
                if mo is not None:
                    return mo

        # 2. Check positional arguments
        if args:
            for arg in args:
                mo = self._resolve_message_object(arg)
                if mo is not None:
                    return mo

        # 3. Check tracked last selected message from cell/activity hooks
        if hasattr(self, "_last_selected_message") and self._last_selected_message is not None:
            mo = self._resolve_message_object(self._last_selected_message)
            if mo is not None:
                return mo

        # 4. Check active ChatActivity / LaunchActivity
        try:
            from org.telegram.ui import LaunchActivity
            frag = None
            if hasattr(LaunchActivity, "getLastFragment"):
                frag = LaunchActivity.getLastFragment()
            if not frag and hasattr(LaunchActivity, "visibleFragments"):
                vf = LaunchActivity.visibleFragments
                if vf:
                    cnt = vf.size() if hasattr(vf, "size") else len(vf)
                    if cnt > 0:
                        frag = vf.get(cnt - 1) if hasattr(vf, "get") else vf[-1]
            if frag is not None:
                mo = self._resolve_message_object(frag)
                if mo is not None:
                    return mo
        except Exception:
            pass

        return None

    def _extract_custom_emoji_ids(self, message: Any) -> List[int]:
        found_ids: List[int] = []
        if message is None:
            return found_ids

        def _add_id(val: Any):
            if val is None:
                return
            safe = _safe_int(val, 0)
            if safe > 0 and safe not in found_ids:
                found_ids.append(safe)

        # 1. MessageOwner & entities list
        msg_owner = getattr(message, "messageOwner", None) or message

        def _scan_entities(entities: Any):
            if not entities:
                return
            cnt = entities.size() if hasattr(entities, "size") else len(entities)
            for i in range(cnt):
                entity = entities.get(i) if hasattr(entities, "get") else entities[i]
                if entity is None:
                    continue
                # TL_messageEntityCustomEmoji document_id / documentId
                doc_id = getattr(entity, "document_id", None) or getattr(entity, "documentId", None)
                if doc_id is not None:
                    _add_id(doc_id)
                elif hasattr(entity, "document") and entity.document:
                    _add_id(getattr(entity.document, "id", None))

        if hasattr(msg_owner, "entities"):
            _scan_entities(msg_owner.entities)
        if hasattr(message, "entities") and message != msg_owner:
            _scan_entities(message.entities)
        if hasattr(message, "captionEntities"):
            _scan_entities(message.captionEntities)
        if hasattr(msg_owner, "captionEntities"):
            _scan_entities(msg_owner.captionEntities)

        # 2. Spannable text (messageText, caption, text)
        for text_field in ("messageText", "caption", "text"):
            text_obj = getattr(message, text_field, None) or getattr(msg_owner, text_field, None)
            if text_obj is not None:
                if hasattr(text_obj, "getSpans"):
                    try:
                        t_len = text_obj.length() if hasattr(text_obj, "length") else len(text_obj)
                        spans = None
                        try:
                            spans = text_obj.getSpans(0, t_len, None)
                        except Exception:
                            try:
                                from java.lang import Object as JObject
                                spans = text_obj.getSpans(0, t_len, JObject)
                            except Exception:
                                pass
                        if spans is not None:
                            s_cnt = spans.size() if hasattr(spans, "size") else len(spans)
                            for i in range(s_cnt):
                                span = spans.get(i) if hasattr(spans, "get") else spans[i]
                                if span is None:
                                    continue
                                d_id = (
                                    getattr(span, "documentId", None)
                                    or getattr(span, "document_id", None)
                                    or getattr(span, "docId", None)
                                )
                                if d_id is None and hasattr(span, "getDocumentId"):
                                    try: d_id = span.getDocumentId()
                                    except Exception: pass
                                if d_id is None and hasattr(span, "document"):
                                    doc_obj = getattr(span, "document", None)
                                    if doc_obj:
                                        d_id = getattr(doc_obj, "id", None)
                                if d_id is not None:
                                    _add_id(d_id)
                    except Exception:
                        pass

                # Regex search in string representation (tg://emoji?id=..., document_id=...)
                try:
                    import re
                    s_text = str(text_obj)
                    for m in re.finditer(r'(?:emoji[_-]?id|document[_-]?id)[=":\s]+(\d{10,20})', s_text, re.IGNORECASE):
                        _add_id(m.group(1))
                    for m in re.finditer(r'tg://emoji\?id=(\d{10,20})', s_text, re.IGNORECASE):
                        _add_id(m.group(1))
                except Exception:
                    pass

        # 3. Media / Sticker / Custom Emoji Document (media.document)
        media_obj = getattr(msg_owner, "media", None) or getattr(message, "media", None)
        if media_obj is not None:
            # TL_messageMediaDocument
            doc = getattr(media_obj, "document", None)
            if doc is not None:
                _add_id(getattr(doc, "id", None))
            # TL_messageMediaPaidMedia
            extended_media = getattr(media_obj, "extended_media", None)
            if extended_media:
                em_cnt = extended_media.size() if hasattr(extended_media, "size") else len(extended_media)
                for i in range(em_cnt):
                    em = extended_media.get(i) if hasattr(extended_media, "get") else extended_media[i]
                    em_doc = getattr(em, "document", None)
                    if em_doc:
                        _add_id(getattr(em_doc, "id", None))

        if hasattr(message, "getDocument"):
            try:
                doc = message.getDocument()
                if doc and hasattr(doc, "id"):
                    _add_id(doc.id)
            except Exception:
                pass

        # 4. Reactions
        reactions = getattr(msg_owner, "reactions", None) or getattr(message, "reactions", None)
        if reactions and hasattr(reactions, "results"):
            results = reactions.results
            r_cnt = results.size() if hasattr(results, "size") else len(results)
            for i in range(r_cnt):
                res = results.get(i) if hasattr(results, "get") else results[i]
                reaction = getattr(res, "reaction", None)
                if reaction:
                    _add_id(getattr(reaction, "document_id", None) or getattr(reaction, "documentId", None))

        # 5. Check replyMessageObject if nothing found yet
        if not found_ids and hasattr(message, "replyMessageObject"):
            reply_mo = getattr(message, "replyMessageObject", None)
            if reply_mo and reply_mo != message:
                reply_ids = self._extract_custom_emoji_ids(reply_mo)
                for rid in reply_ids:
                    _add_id(rid)

        # 6. Fallback: Sender user emoji status
        if not found_ids:
            try:
                from_user = getattr(message, "fromUser", None) or getattr(msg_owner, "from_id", None)
                if from_user and hasattr(from_user, "emoji_status") and from_user.emoji_status:
                    _add_id(getattr(from_user.emoji_status, "document_id", None))
            except Exception:
                pass

        return found_ids

    def _on_refresh_single_profile_click(self, *args, **kwargs):
        user, user_id = self._extract_user_from_menu_args(*args, **kwargs)
        if user_id <= 0:
            bulletins.show_error("Не удалось определить ID пользователя.")
            return

        def worker():
            server_url = self.get_setting("server_url", DEFAULT_SERVER_URL).rstrip("/")
            cookie_val = self.get_setting("custom_cookie", DEFAULT_SECRET_COOKIE).strip()

            try:
                url = f"{server_url}/api/profile/{user_id}"
                headers = {
                    "User-Agent": f"SyncProfile/{__version__}",
                    "Cookie": f"{COOKIE_NAME}={cookie_val}",
                }
                req = urllib.request.Request(url, headers=headers)
                with urllib.request.urlopen(req, timeout=6) as resp:
                    if resp.status == 200:
                        resp_data = json.loads(resp.read().decode("utf-8"))
                        prof = resp_data.get("profile") or resp_data
                        if prof and "user_id" in prof:
                            with self._sync_lock:
                                self._profiles_cache[user_id] = prof
                                self._cache_dirty = True
                            self._update_snapshot()
                            self._save_local_profiles_cache()
                            run_on_ui_thread(self._apply_all_to_all_accounts)
                            bulletins.show_success(
                                f"✅ Профиль ID {user_id} обновлен!\nЦвет: #{prof.get('name_color')} | Обложка: #{prof.get('profile_color')}"
                            )
                            return

                bulletins.show_info(f"Профиль ID {user_id} не найден на сервере.")
            except Exception as e:
                logger.error(f"Ошибка обновления профиля {user_id}: {e}")
                bulletins.show_error(f"Ошибка загрузки профиля: {e}")

        threading.Thread(target=worker, daemon=True).start()

    def _on_profile_menu_click(self, *args, **kwargs):
        user, user_id = self._extract_user_from_menu_args(*args, **kwargs)
        if user_id <= 0:
            bulletins.show_info("Не удалось получить объект пользователя.")
            return
        profile = None
        with self._sync_lock:
            profile = self._profiles_cache.get(user_id)

        if profile:
            info = (
                f"👤 ID: {user_id}\n"
                f"⭐ Premium: {'Да' if profile.get('premium') else 'Нет'}\n"
                f"🎨 Цвет имени/реплаев: #{profile.get('name_color', 0)} (узор: {profile.get('name_bg_emoji_id', 0)})\n"
                f"🖼️ Цвет обложки: #{profile.get('profile_color', 0)} (узор: {profile.get('profile_bg_emoji_id', 0)})\n"
                f"🆔 Эмодзи-статус ID: {profile.get('emoji_status_id', 'Нет')}"
            )
            bulletins.show_info(f"SyncProfile активен:\n{info}")
        else:
            bulletins.show_info(f"Пользователь {user_id} не найден в локальной базе.")

    def _on_copy_emoji_id_click(self, *args, **kwargs):
        message = self._extract_message_from_menu_args(*args, **kwargs)
        if not message:
            bulletins.show_error("Сообщение не найдено.")
            return

        doc_ids = self._extract_custom_emoji_ids(message)

        if doc_ids:
            found_id = str(doc_ids[0])
            if len(doc_ids) == 1:
                self._copy_text_to_clipboard(found_id, f"🆔 Emoji ID скопирован:\n{found_id}")
            else:
                all_ids_str = ", ".join(str(d) for d in doc_ids)
                self._copy_text_to_clipboard(
                    found_id,
                    f"🆔 Скопирован 1-й Emoji ID: {found_id}\n(Найдено {len(doc_ids)}: {all_ids_str})"
                )
        else:
            bulletins.show_info("В этом сообщении не найдено кастомных эмодзи.")

    def _copy_text_to_clipboard(self, text: str, success_msg: str = ""):
        if not text:
            return
        try:
            from org.telegram.messenger import AndroidUtilities
            AndroidUtilities.addToClipboard(text)
            if not success_msg:
                success_msg = f"Скопировано: {text}"
            bulletins.show_with_copy("Скопировано", text)
            return
        except Exception:
            pass

        try:
            from android.content import Context, ClipData
            from org.telegram.messenger import ApplicationLoader
            ctx = getattr(ApplicationLoader, "applicationContext", None)
            if ctx:
                cm = ctx.getSystemService(Context.CLIPBOARD_SERVICE)
                clip = ClipData.newPlainText("text", text)
                cm.setPrimaryClip(clip)
                if not success_msg:
                    success_msg = f"Скопировано: {text}"
                bulletins.show_with_copy("Скопировано", text)
                return
        except Exception:
            pass

        bulletins.show_info(f"Скопировано: {text}")

    def create_settings(self) -> List[Any]:
        with self._sync_lock:
            total_cached = len(self._profiles_cache)

        items = [
            Header(text="Синхронизация профилей SyncProfile"),
            Switch(
                key="enable_sync",
                text="Включить SyncProfile",
                default=True,
                subtext="Отображать кастомные профили и цвета других пользователей плагина",
                icon="msg_sync",
            ),
        ]

        if ALLOW_CUSTOM_SERVER_CONFIG:
            items.extend([
                Input(
                    key="server_url",
                    text="URL сервера",
                    default=DEFAULT_SERVER_URL,
                    subtext="Адрес сервера (https://sync.efn.mom)",
                    icon="msg_link",
                ),
                Input(
                    key="custom_cookie",
                    text="Секретный токен Cookie",
                    default=DEFAULT_SECRET_COOKIE,
                    subtext="Ключ авторизации для доступа к sync.efn.mom",
                    icon="msg_secret",
                ),
            ])

        items.extend([
            Divider(text="Общие действия"),
            Text(
                text="⚡ Быстрая дельта-синхронизация",
                subtext="Запросить только новые и измененные профили с сервера (быстро и экономно)",
                icon="msg_sync",
                accent=True,
                on_click=lambda view: self.sync_delta_updates_from_server(show_bulletin=True),
            ),
            Text(
                text="🌐 Опубликовать ВСЕ мои аккаунты сразу",
                subtext="Отправить индивидуальные цвета всех аккаунтов на сервер в один клик",
                icon="msg_send",
                accent=True,
                on_click=lambda view: self.push_all_accounts(show_ui_bulletin=True),
            ),
            Text(
                text=f"📥 Полное скачивание базы ({total_cached} в кэше)",
                subtext="Удалить старый локальный кэш и начисто скачать актуальную базу с сервера",
                icon="msg_download",
                accent=True,
                on_click=lambda view: self._sync_database(show_bulletin=True, force_clean=True),
            ),
        ])

        active_accs = self._get_active_accounts_data()

        for acc_info in active_accs:
            acc_idx = acc_info.get("acc_idx", 0)
            uid = acc_info.get("user_id", 0)
            name = acc_info.get("name", f"Аккаунт {acc_idx + 1}")
            extra = acc_info.get("extra", "")
            is_curr = acc_info.get("is_current", False)

            curr_tag = " [ТЕКУЩИЙ АКТИВНЫЙ]" if is_curr else ""
            section_title = f"👤 {name}{extra} (ID: {uid}){curr_tag}"

            default_name_c = 0
            default_prof_c = 0

            cur_prem = bool(self._get_slot_val(acc_idx, "premium", True))
            cur_name_c = int(self._get_slot_val(acc_idx, "name_color", default_name_c) or 0)
            cur_prof_c = int(self._get_slot_val(acc_idx, "profile_color", default_prof_c) or 0)

            if cur_name_c < 0 or cur_name_c >= len(NAME_AND_REPLY_COLORS):
                cur_name_c = default_name_c
            if cur_prof_c < 0 or cur_prof_c >= len(PROFILE_COLORS):
                cur_prof_c = default_prof_c

            cur_name_bg = self._get_slot_val(acc_idx, "name_bg_emoji_id", DEFAULT_NAME_BG_EMOJI) or ""
            cur_prof_bg = self._get_slot_val(acc_idx, "profile_bg_emoji_id", DEFAULT_PROFILE_BG_EMOJI) or ""
            cur_em_id = self._get_slot_val(acc_idx, "emoji_status_id", DEFAULT_EMOJI_STATUS_ID) or ""

            items.extend([
                Divider(text=section_title),
                Text(
                    text=f"🚀 Опубликовать профиль {name}",
                    subtext=f"Отправить цвета и узоры для ID {uid} на сервер",
                    icon="msg_send",
                    accent=True,
                    on_click=lambda view, a=acc_idx: self.push_specific_account(a, show_ui_bulletin=True),
                ),
                Switch(
                    key=f"slot_{acc_idx}_premium",
                    text=f"Telegram Premium [{name}]",
                    default=cur_prem,
                    subtext=f"Отображать Premium-статус и звездочку для {name}",
                    icon="msg_premium",
                    on_change=lambda val, a=acc_idx: (self._set_slot_val(a, "premium", val), run_on_ui_thread(self._apply_all_to_all_accounts)),
                ),
                Selector(
                    key=f"slot_{acc_idx}_name_color",
                    text=f"Цвет имени и реплаев [{name}]",
                    default=cur_name_c,
                    items=NAME_AND_REPLY_COLORS,
                    icon="msg_palette",
                    on_change=lambda idx, a=acc_idx: (self._set_slot_val(a, "name_color", idx), run_on_ui_thread(self._apply_all_to_all_accounts)),
                ),
                Input(
                    key=f"slot_{acc_idx}_name_bg_emoji_id",
                    text=f"Узор имени и реплаев [{name}]",
                    default=cur_name_bg,
                    subtext="Document ID эмодзи-узора (оставьте пустым, если не нужен)",
                    icon="msg_background",
                    on_change=lambda val, a=acc_idx: (self._set_slot_val(a, "name_bg_emoji_id", val), run_on_ui_thread(self._apply_all_to_all_accounts)),
                ),
                Selector(
                    key=f"slot_{acc_idx}_profile_color",
                    text=f"Цвет обложки [{name}]",
                    default=cur_prof_c,
                    items=PROFILE_COLORS,
                    icon="msg_theme",
                    on_change=lambda idx, a=acc_idx: (self._set_slot_val(a, "profile_color", idx), run_on_ui_thread(self._apply_all_to_all_accounts)),
                ),
                Input(
                    key=f"slot_{acc_idx}_profile_bg_emoji_id",
                    text=f"Узор обложки [{name}]",
                    default=cur_prof_bg,
                    subtext="ID эмодзи-узора (значки вокруг аватарки, оставьте пустым)",
                    icon="msg_background",
                    on_change=lambda val, a=acc_idx: (self._set_slot_val(a, "profile_bg_emoji_id", val), run_on_ui_thread(self._apply_all_to_all_accounts)),
                ),
                Input(
                    key=f"slot_{acc_idx}_emoji_status_id",
                    text=f"Эмодзи-статус [{name}]",
                    default=cur_em_id,
                    subtext="ID эмодзи-статуса рядом с именем (оставьте пустым, если не нужен)",
                    icon="msg_emoji",
                    on_change=lambda val, a=acc_idx: (self._set_slot_val(a, "emoji_status_id", val), run_on_ui_thread(self._apply_all_to_all_accounts)),
                ),
            ])

        items.extend([
            Divider(text="Действия"),
            Text(
                text="🧹 Очистить локальный кэш",
                icon="msg_delete",
                red=True,
                on_click=self._clear_cache_action,
            ),
        ])

        return items

    def _clear_cache_action(self, view: Any = None):
        with self._sync_lock:
            self._profiles_cache.clear()
            self._cache_dirty = False
        if self._json_cache_file:
            try:
                self._json_cache_file.wipe()
            except Exception:
                pass
        self._update_snapshot()
        self._save_local_profiles_cache(force=True)
        self._apply_all_to_all_accounts()
        bulletins.show_success("Локальный кэш SyncProfile очищен!")
